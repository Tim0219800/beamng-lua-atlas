{
  "path": "lua/ge/extensions/editor/dragRaceEditor/state.lua",
  "module": "Shared state of the drag race editor: a single local State table (race data, current file, lane/facility/strip selection indices, mouse, undo/redo stack, displayed error, zone edit target, search). All other submodules access it via trivial getters/setters.",
  "notes": [
    "Module of simple accessors: each getXxx returns State.xxx and each setXxx assigns it, without validation.",
    "Initial values: current folder \"/levels/\", selection indices -1, maxUndoSteps 20, usingPrefabs and hasEndCamera are im.BoolPtr(false)."
  ],
  "functions": {
    "getState": {
      "desc": "Returns the complete State table.",
      "params": {},
      "returns": [
        {
          "type": "table",
          "desc": "state"
        }
      ]
    },
    "setState": {
      "desc": "Replaces the whole State table.",
      "params": {
        "newState": {
          "type": "table",
          "desc": "new state"
        }
      }
    },
    "getDragRaceData": {
      "desc": "Race data being edited.",
      "params": {},
      "returns": [
        {
          "type": "table|nil",
          "desc": "dragRaceData"
        }
      ]
    },
    "setDragRaceData": {
      "desc": "Sets the race data.",
      "params": {
        "data": {
          "type": "table|nil",
          "desc": "data"
        }
      }
    },
    "getSelectedLaneIndex": {
      "desc": "Selected lane index (-1 if none).",
      "params": {},
      "returns": [
        {
          "type": "integer",
          "desc": "index"
        }
      ]
    },
    "setSelectedLaneIndex": {
      "desc": "Sets the selected lane index.",
      "params": {
        "index": {
          "type": "integer",
          "desc": "index"
        }
      }
    },
    "getSelectedFacilityIndex": {
      "desc": "Selected facility index (-1 if none).",
      "params": {},
      "returns": [
        {
          "type": "integer",
          "desc": "index"
        }
      ]
    },
    "setSelectedFacilityIndex": {
      "desc": "Sets the selected facility index.",
      "params": {
        "index": {
          "type": "integer",
          "desc": "index"
        }
      }
    },
    "getSelectedStripIndex": {
      "desc": "Selected strip index (-1 if none).",
      "params": {},
      "returns": [
        {
          "type": "integer",
          "desc": "index"
        }
      ]
    },
    "setSelectedStripIndex": {
      "desc": "Sets the selected strip index.",
      "params": {
        "index": {
          "type": "integer",
          "desc": "index"
        }
      }
    },
    "getMouseInfo": {
      "desc": "Mouse info table filled by utils.updateMouseInfo.",
      "params": {},
      "returns": [
        {
          "type": "table|nil",
          "desc": "mouseInfo"
        }
      ]
    },
    "setMouseInfo": {
      "desc": "Sets the mouse info table.",
      "params": {
        "info": {
          "type": "table|nil",
          "desc": "mouseInfo"
        }
      }
    },
    "getHasUnsavedChanges": {
      "desc": "Indicates whether there are unsaved changes.",
      "params": {},
      "returns": [
        {
          "type": "boolean",
          "desc": "flag"
        }
      ]
    },
    "setHasUnsavedChanges": {
      "desc": "Sets the unsaved changes flag.",
      "params": {
        "value": {
          "type": "boolean",
          "desc": "flag"
        }
      }
    },
    "getTransforms": {
      "desc": "Table of editor transforms.",
      "params": {},
      "returns": [
        {
          "type": "table",
          "desc": "transforms"
        }
      ]
    },
    "setTransforms": {
      "desc": "Sets the transforms table.",
      "params": {
        "transforms": {
          "type": "table",
          "desc": "transforms"
        }
      }
    },
    "getCurrentFileDir": {
      "desc": "Folder of the current file.",
      "params": {},
      "returns": [
        {
          "type": "string",
          "desc": "folder, \"/levels/\" by default"
        }
      ]
    },
    "setCurrentFileDir": {
      "desc": "Sets the folder of the current file.",
      "params": {
        "dir": {
          "type": "string",
          "desc": "folder"
        }
      }
    },
    "getCurrentFileName": {
      "desc": "Name of the current file.",
      "params": {},
      "returns": [
        {
          "type": "string|nil",
          "desc": "name"
        }
      ]
    },
    "setCurrentFileName": {
      "desc": "Sets the name of the current file.",
      "params": {
        "name": {
          "type": "string|nil",
          "desc": "name"
        }
      }
    },
    "getUndoStack": {
      "desc": "Undo stack (copies of dragRaceData).",
      "params": {},
      "returns": [
        {
          "type": "table",
          "desc": "stack"
        }
      ]
    },
    "setUndoStack": {
      "desc": "Replaces the undo stack.",
      "params": {
        "stack": {
          "type": "table",
          "desc": "stack"
        }
      }
    },
    "getRedoStack": {
      "desc": "Redo stack.",
      "params": {},
      "returns": [
        {
          "type": "table",
          "desc": "stack"
        }
      ]
    },
    "setRedoStack": {
      "desc": "Replaces the redo stack.",
      "params": {
        "stack": {
          "type": "table",
          "desc": "stack"
        }
      }
    },
    "getMaxUndoSteps": {
      "desc": "Maximum number of undo steps (20).",
      "params": {},
      "returns": [
        {
          "type": "integer",
          "desc": "20"
        }
      ]
    },
    "getLastError": {
      "desc": "Last displayed error message.",
      "params": {},
      "returns": [
        {
          "type": "string|nil",
          "desc": "message"
        }
      ]
    },
    "setLastError": {
      "desc": "Sets the error message.",
      "params": {
        "error": {
          "type": "string|nil",
          "desc": "message"
        }
      }
    },
    "getErrorTimeout": {
      "desc": "Remaining time (s) for displaying the error.",
      "params": {},
      "returns": [
        {
          "type": "number",
          "desc": "seconds"
        }
      ]
    },
    "setErrorTimeout": {
      "desc": "Sets the remaining error display time.",
      "params": {
        "timeout": {
          "type": "number",
          "desc": "seconds"
        }
      }
    },
    "getUsingPrefabs": {
      "desc": "ImGui boolean pointer \"uses prefabs\".",
      "params": {},
      "returns": [
        {
          "type": "userdata",
          "desc": "im.BoolPtr"
        }
      ]
    },
    "getHasEndCamera": {
      "desc": "ImGui boolean pointer \"has an end camera\".",
      "params": {},
      "returns": [
        {
          "type": "userdata",
          "desc": "im.BoolPtr"
        }
      ]
    },
    "getSearch": {
      "desc": "searchUtil object used for dropdowns with search.",
      "params": {},
      "returns": [
        {
          "type": "table",
          "desc": "searchUtil"
        }
      ]
    },
    "getZoneEditTarget": {
      "desc": "Zone edit target (type stripZone or laneZone, with strip/lane).",
      "params": {},
      "returns": [
        {
          "type": "table|nil",
          "desc": "target"
        }
      ]
    },
    "setZoneEditTarget": {
      "desc": "Sets the zone edit target.",
      "params": {
        "target": {
          "type": "table|nil",
          "desc": "target"
        }
      }
    },
    "getZoneEditPreviousEditMode": {
      "desc": "Editor edit mode that was active before entering zone editing.",
      "params": {},
      "returns": [
        {
          "type": "any",
          "desc": "mode"
        }
      ]
    },
    "setZoneEditPreviousEditMode": {
      "desc": "Stores the previous edit mode.",
      "params": {
        "mode": {
          "type": "any",
          "desc": "mode"
        }
      }
    }
  }
}
