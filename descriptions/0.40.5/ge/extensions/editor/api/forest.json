{
  "path": "lua/ge/extensions/editor/api/forest.lua",
  "module": "Editor API for manipulating forest items (trees, rocks, etc. instanced via ForestData). initialize(editor) adds functions to editor to add, remove, update, rotate and select ForestItems. Functions that modify the forest set editor.forestDirty = true and call editor.setDirty().",
  "notes": [
    "updateForestItem and rotateForestSelection replace the item: the returned object must be used (updateItem returns a new item).",
    "rotateForestSelection only acts on editor.selection.forestItem; a single selection rotates around its own axis (or the world's depending on editor.getAxisGizmoAlignment()), several rotate around centerPoint.",
    "rotateForestSelection does not mark forestDirty itself.",
    "The comment of createForestItem says \"from where to remove the item\" for forestData (copy-paste); it is actually the forest where the item is created."
  ],
  "functions": {
    "initialize": {
      "desc": "Installs this module's functions on the editor object.",
      "params": {
        "editorInstance": {
          "type": "table",
          "desc": "editor object"
        }
      },
      "returns": [],
      "internal": true
    }
  },
  "classes": {
    "editor": {
      "desc": "Functions added to the editor object by initialize.",
      "functions": {
        "rotateForestSelection": {
          "desc": "Applies a delta rotation to the selected forest items from their original transforms.",
          "params": {
            "forestData": {
              "type": "userdata",
              "desc": "ForestData (C++) containing the items"
            },
            "deltaEulerRotation": {
              "type": "vec3",
              "desc": "Euler rotation to add"
            },
            "centerPoint": {
              "type": "vec3",
              "desc": "Rotation center (multiple selection)"
            },
            "originalTransforms": {
              "type": "table<integer, MatrixF>",
              "desc": "Transforms before rotation, in selection order"
            }
          },
          "returns": []
        },
        "addForestItem": {
          "desc": "Adds an existing ForestItem to the forest.",
          "params": {
            "forestData": {
              "type": "userdata",
              "desc": "ForestData"
            },
            "item": {
              "type": "userdata",
              "desc": "ForestItem to add"
            }
          },
          "returns": []
        },
        "removeForestItem": {
          "desc": "Removes a ForestItem from the forest.",
          "params": {
            "forestData": {
              "type": "userdata",
              "desc": "ForestData"
            },
            "item": {
              "type": "userdata",
              "desc": "ForestItem to remove"
            }
          },
          "returns": []
        },
        "createForestItem": {
          "desc": "Creates a new item using an existing item as a template, with a transform and a scale.",
          "params": {
            "forestData": {
              "type": "userdata",
              "desc": "ForestData"
            },
            "itemData": {
              "type": "userdata",
              "desc": "Stored data of an existing ForestItem"
            },
            "transform": {
              "type": "MatrixF",
              "desc": "New transform"
            },
            "scale": {
              "type": "number",
              "desc": "New scale"
            }
          },
          "returns": [
            {
              "type": "userdata",
              "desc": "The created ForestItem"
            }
          ]
        },
        "updateForestItem": {
          "desc": "Updates an instance's information (data, transform, scale, uid).",
          "params": {
            "forestData": {
              "type": "userdata",
              "desc": "ForestData"
            },
            "key": {
              "type": "any",
              "desc": "Item key"
            },
            "keyPos": {
              "type": "vec3",
              "desc": "Original position of the item"
            },
            "newData": {
              "type": "userdata",
              "desc": "Stored data of the item"
            },
            "newTrans": {
              "type": "MatrixF",
              "desc": "New transform"
            },
            "newScale": {
              "type": "number",
              "desc": "New scale"
            },
            "newUid": {
              "type": "any",
              "desc": "Unique identifier"
            }
          },
          "returns": [
            {
              "type": "userdata",
              "desc": "The updated ForestItem"
            }
          ]
        },
        "setForestItemCustomData": {
          "desc": "Sets an item's opaque custom data.",
          "params": {
            "forestData": {
              "type": "userdata",
              "desc": "ForestData"
            },
            "key": {
              "type": "any",
              "desc": "Item key"
            },
            "customData": {
              "type": "number",
              "desc": "Packed value (-1 = none)"
            }
          },
          "returns": [
            {
              "type": "userdata",
              "desc": "The ForestItem"
            }
          ]
        },
        "setForestItemSelected": {
          "desc": "Marks an item as selected or not (does not mark the forest as modified).",
          "params": {
            "forestData": {
              "type": "userdata",
              "desc": "ForestData"
            },
            "key": {
              "type": "any",
              "desc": "Item key"
            },
            "selected": {
              "type": "boolean",
              "desc": "Selection state (inferred from code)"
            }
          },
          "returns": [
            {
              "type": "any",
              "desc": "Result of forestData:setItemSelected"
            }
          ]
        }
      }
    }
  }
}
