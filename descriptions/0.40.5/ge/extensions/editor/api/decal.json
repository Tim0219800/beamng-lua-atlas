{
  "path": "lua/ge/extensions/editor/api/decal.lua",
  "module": "Editor API for terrain/object decals (Engine.Render.DecalMgr): creation and deletion of templates (DecalData), adding/removing instances, lookup and saving. initialize(editor) creates the decalPersistMan PersistenceManager and adds the functions to editor. Templates are saved in art/decals/managedDecalData.json of the mission folder, instances in main.decals.json.",
  "notes": [
    "If the mission name cannot be found, getDecalDataFilePath logs an error and falls back to the default relative path.",
    "getDecalInstance and getDecalInstanceByUid return nil if the instance has no valid id/uid fields.",
    "In getDecalInstanceByUid, the uid is passed to DecalMgr.getDecalInstance (same call as for an index): the engine handles both (inferred from code).",
    "Deleted templates are queued and only actually removed from the file by saveDecals."
  ],
  "functions": {
    "initialize": {
      "desc": "Creates decalPersistMan if it does not exist and installs the functions on the editor object.",
      "params": {
        "editorInstance": {
          "type": "table",
          "desc": "editor object"
        }
      },
      "returns": [],
      "internal": true
    }
  },
  "classes": {
    "editor": {
      "desc": "Functions added to the editor object by initialize.",
      "functions": {
        "getDecalDataFilePath": {
          "desc": "Path of the templates file: mission folder + art/decals/managedDecalData.json.",
          "params": {},
          "returns": [
            {
              "type": "string",
              "desc": "Path"
            }
          ]
        },
        "createDecalTemplate": {
          "desc": "Creates a DecalData with the unique name NewTemplate (WarningMaterial material) and marks it as modified for the decals file.",
          "params": {},
          "returns": [
            {
              "type": "integer",
              "desc": "Template ID"
            }
          ]
        },
        "deleteDecalTemplate": {
          "desc": "Deletes all instances using this template, removes the template from the set and queues it for deletion at the next saveDecals.",
          "params": {
            "template": {
              "type": "userdata",
              "desc": "DecalData template"
            }
          },
          "returns": []
        },
        "getDecalTemplates": {
          "desc": "Returns the set of templates (DecalMgr.getSet()).",
          "params": {},
          "returns": [
            {
              "type": "userdata",
              "desc": "Templates SimSet"
            }
          ]
        },
        "hasDirtyDecalTemplates": {
          "desc": "Returns whether any templates have unsaved changes.",
          "params": {},
          "returns": [
            {
              "type": "boolean",
              "desc": "true if modified"
            }
          ]
        },
        "addDecalInstance": {
          "desc": "Adds a decal instance oriented by a normal and a rotation around it.",
          "params": {
            "pos": {
              "type": "vec3",
              "desc": "Position"
            },
            "normal": {
              "type": "vec3",
              "desc": "Normal"
            },
            "rotAroundNormal": {
              "type": "number",
              "desc": "Rotation around the normal"
            },
            "template": {
              "type": "userdata",
              "desc": "DecalData template"
            },
            "decalScale": {
              "type": "number|nil",
              "desc": "Scale, 1 by default"
            },
            "decalTexIndex": {
              "type": "integer|nil",
              "desc": "Texture index, -1 by default"
            },
            "flags": {
              "type": "integer|nil",
              "desc": "Flags, 0 by default"
            },
            "initialAlpha": {
              "type": "number|nil",
              "desc": "Initial alpha, 1 by default"
            }
          },
          "returns": [
            {
              "type": "userdata",
              "desc": "Created instance"
            }
          ]
        },
        "addDecalInstanceWithTan": {
          "desc": "Like addDecalInstance but oriented by a tangent vector.",
          "params": {
            "pos": {
              "type": "vec3",
              "desc": "Position"
            },
            "normal": {
              "type": "vec3",
              "desc": "Normal"
            },
            "tangent": {
              "type": "vec3",
              "desc": "Tangent"
            },
            "template": {
              "type": "userdata",
              "desc": "DecalData template"
            },
            "decalScale": {
              "type": "number|nil",
              "desc": "Scale, 1 by default"
            },
            "decalTexIndex": {
              "type": "integer|nil",
              "desc": "Texture index, -1 by default"
            },
            "flags": {
              "type": "integer|nil",
              "desc": "Flags, 0 by default"
            },
            "initialAlpha": {
              "type": "number|nil",
              "desc": "Initial alpha, 1 by default"
            }
          },
          "returns": [
            {
              "type": "userdata",
              "desc": "Created instance"
            }
          ]
        },
        "addDecalInstanceWithTanForceId": {
          "desc": "Like addDecalInstanceWithTan but forcing the instance index.",
          "params": {
            "pos": {
              "type": "vec3",
              "desc": "Position"
            },
            "normal": {
              "type": "vec3",
              "desc": "Normal"
            },
            "tangent": {
              "type": "vec3",
              "desc": "Tangent"
            },
            "template": {
              "type": "userdata",
              "desc": "DecalData template"
            },
            "decalScale": {
              "type": "number|nil",
              "desc": "Scale, 1 by default"
            },
            "decalTexIndex": {
              "type": "integer|nil",
              "desc": "Texture index, -1 by default"
            },
            "flags": {
              "type": "integer|nil",
              "desc": "Flags, 0 by default"
            },
            "initialAlpha": {
              "type": "number|nil",
              "desc": "Initial alpha, 1 by default"
            },
            "index": {
              "type": "integer",
              "desc": "Forced index (inferred from code)"
            }
          },
          "returns": [
            {
              "type": "userdata",
              "desc": "Created instance"
            }
          ]
        },
        "getDecalInstance": {
          "desc": "Returns the instance with the given index, or nil if invalid.",
          "params": {
            "index": {
              "type": "integer",
              "desc": "Index"
            }
          },
          "returns": [
            {
              "type": "userdata|nil",
              "desc": "Instance"
            }
          ]
        },
        "getDecalInstanceByUid": {
          "desc": "Returns the instance with the given uid, or nil if invalid.",
          "params": {
            "uid": {
              "type": "integer",
              "desc": "Uid"
            }
          },
          "returns": [
            {
              "type": "userdata|nil",
              "desc": "Instance"
            }
          ]
        },
        "getDecalInstanceVecSize": {
          "desc": "Number of slots in the instances array.",
          "params": {},
          "returns": [
            {
              "type": "integer",
              "desc": "Size"
            }
          ]
        },
        "deleteDecalInstance": {
          "desc": "Deletes an instance and marks the editor as modified.",
          "params": {
            "instance": {
              "type": "userdata",
              "desc": "Instance"
            }
          },
          "returns": []
        },
        "getClosestDecal": {
          "desc": "Returns the decal closest to a position.",
          "params": {
            "pos": {
              "type": "vec3",
              "desc": "Position"
            }
          },
          "returns": [
            {
              "type": "userdata|nil",
              "desc": "Closest instance"
            }
          ]
        },
        "notifyDecalModified": {
          "desc": "Tells the engine that an instance has changed and marks the editor as modified.",
          "params": {
            "instance": {
              "type": "userdata",
              "desc": "Instance"
            }
          },
          "returns": []
        },
        "isDecalDirty": {
          "desc": "Returns whether the decal/template has unsaved changes.",
          "params": {
            "decal": {
              "type": "userdata",
              "desc": "Template"
            }
          },
          "returns": [
            {
              "type": "boolean",
              "desc": "true if modified"
            }
          ]
        },
        "saveDecal": {
          "desc": "Saves a modified template.",
          "params": {
            "template": {
              "type": "userdata",
              "desc": "Template"
            }
          },
          "returns": []
        },
        "saveDecals": {
          "desc": "Purges the templates queued for deletion, saves the modified templates and writes the instances to main.decals.json in the mission folder.",
          "params": {},
          "returns": []
        }
      }
    }
  }
}
