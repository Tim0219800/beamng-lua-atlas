{
  "path": "lua/ge/extensions/editor/crawlEditor/presets.lua",
  "module": "Preset and component manager of the Crawl editor (trails, boundaries, paths/pathnodes). The module returns a class C (constructor) and is not a classic extension. Presets are stored in one JSON file per level (/levels/<level>/crawls/presets.json, or settings/cloud/crawls/presets.json if no level is loaded); \"components\" are delegated to the gameplay/crawl/saveSystem module. Also provides the ImGui \"Components\" menu and the save/management dialogs.",
  "notes": [
    "The presets file path (self.PRESETS_FILE) is computed only once in init() from the current level; if the level changes, the object must be recreated.",
    "The save/delete/import/export functions return (boolean, path|nil); the load*Preset functions return (object|nil, file path|nil).",
    "A stored preset is a table {name, category, data, created, modified}; category is \"trails\", \"boundaries\" or \"pathnodes\" (self.PRESET_CATEGORIES).",
    "Individual export/import file: expected extension self.PRESET_EXTENSION = \".preset.json\"."
  ],
  "classes": {
    "C": {
      "desc": "Presets object of the Crawl editor. Main fields: presets (categories + metadata), PRESETS_FILE, PRESET_CATEGORIES, showSave*Dialog, showPresetManager(Ptr), *PresetName (256-character ImGui buffers).",
      "functions": {
        "init": {
          "desc": "Initializes the empty presets table, the dialog states and the ImGui buffers, computes the presets file path for the current level then calls loadPresets().",
          "internal": true
        },
        "loadPresets": {
          "desc": "Reads the presets JSON file; if it does not exist, immediately writes an empty file via savePresets()."
        },
        "savePresets": {
          "desc": "Updates the modification date, creates the folder if needed (FS:directoryCreate) and writes the whole presets file.",
          "returns": [
            {
              "type": "boolean",
              "desc": "success"
            },
            {
              "type": "string|nil",
              "desc": "path written"
            }
          ]
        },
        "saveBoundaryPreset": {
          "desc": "Serializes a boundary (boundary:onSerialize) and records it as a preset of category boundaries, then saves the file. Fails if the name is empty or the boundary has no vertex.",
          "params": {
            "name": {
              "type": "string",
              "desc": "preset name"
            },
            "boundary": {
              "type": "table",
              "desc": "boundary object with onSerialize method"
            }
          },
          "returns": [
            {
              "type": "boolean",
              "desc": "success"
            },
            {
              "type": "string|nil",
              "desc": "file path"
            }
          ]
        },
        "savePathnodePreset": {
          "desc": "Records a path (name, description, nodes with position, rotation, default radius 6.0, flags) as a pathnodes preset.",
          "params": {
            "name": {
              "type": "string",
              "desc": "preset name"
            },
            "path": {
              "type": "table",
              "desc": "path with nodes list"
            }
          },
          "returns": [
            {
              "type": "boolean",
              "desc": "success"
            },
            {
              "type": "string|nil",
              "desc": "file path"
            }
          ]
        },
        "saveTrailPreset": {
          "desc": "Serializes a complete trail (path + boundary) and records it as a trails preset.",
          "params": {
            "name": {
              "type": "string",
              "desc": "preset name"
            },
            "trail": {
              "type": "table",
              "desc": "trail to save"
            }
          },
          "returns": [
            {
              "type": "boolean",
              "desc": "success"
            },
            {
              "type": "string|nil",
              "desc": "file path"
            }
          ]
        },
        "loadBoundaryPreset": {
          "desc": "Validates then deserializes the named boundary preset.",
          "params": {
            "name": {
              "type": "string",
              "desc": "preset name"
            }
          },
          "returns": [
            {
              "type": "table|nil",
              "desc": "rebuilt boundary"
            },
            {
              "type": "string|nil",
              "desc": "presets file"
            }
          ]
        },
        "loadPathnodePreset": {
          "desc": "Validates then deserializes the named path preset.",
          "params": {
            "name": {
              "type": "string",
              "desc": "preset name"
            }
          },
          "returns": [
            {
              "type": "table|nil",
              "desc": "rebuilt path"
            },
            {
              "type": "string|nil",
              "desc": "presets file"
            }
          ]
        },
        "loadTrailPreset": {
          "desc": "Validates then deserializes the named trail preset.",
          "params": {
            "name": {
              "type": "string",
              "desc": "preset name"
            }
          },
          "returns": [
            {
              "type": "table|nil",
              "desc": "rebuilt trail"
            },
            {
              "type": "string|nil",
              "desc": "presets file"
            }
          ]
        },
        "deleteBoundaryPreset": {
          "desc": "Deletes the boundary preset and saves the file. Returns false, nil if the preset does not exist.",
          "params": {
            "name": {
              "type": "string",
              "desc": "preset name"
            }
          },
          "returns": [
            {
              "type": "boolean",
              "desc": "success"
            },
            {
              "type": "string|nil",
              "desc": "file path"
            }
          ]
        },
        "deletePathnodePreset": {
          "desc": "Deletes the path preset and saves the file.",
          "params": {
            "name": {
              "type": "string",
              "desc": "preset name"
            }
          },
          "returns": [
            {
              "type": "boolean",
              "desc": "success"
            },
            {
              "type": "string|nil",
              "desc": "file path"
            }
          ]
        },
        "deleteTrailPreset": {
          "desc": "Deletes the trail preset and saves the file.",
          "params": {
            "name": {
              "type": "string",
              "desc": "preset name"
            }
          },
          "returns": [
            {
              "type": "boolean",
              "desc": "success"
            },
            {
              "type": "string|nil",
              "desc": "file path"
            }
          ]
        },
        "getBoundaryPresets": {
          "desc": "Lists the boundary presets as an array {name, preset} (order not guaranteed, from pairs).",
          "returns": [
            {
              "type": "table[]",
              "desc": "list of {name, preset}"
            }
          ]
        },
        "getPathnodePresets": {
          "desc": "Lists the path presets as {name, preset}.",
          "returns": [
            {
              "type": "table[]",
              "desc": "list of {name, preset}"
            }
          ]
        },
        "getTrailPresets": {
          "desc": "Lists the trail presets as {name, preset}.",
          "returns": [
            {
              "type": "table[]",
              "desc": "list of {name, preset}"
            }
          ]
        },
        "getAllTrailComponents": {
          "desc": "Lists the trail components of the current level via saveSystem (folder /levels/<level>/crawls/).",
          "returns": [
            {
              "type": "table",
              "desc": "list of components (with id and name)"
            }
          ]
        },
        "getAllBoundaryComponents": {
          "desc": "Lists the boundary components of the current level via saveSystem.",
          "returns": [
            {
              "type": "table",
              "desc": "list of components"
            }
          ]
        },
        "getAllPathnodeComponents": {
          "desc": "Lists the path components of the current level via saveSystem.",
          "returns": [
            {
              "type": "table",
              "desc": "list of components"
            }
          ]
        },
        "loadTrailComponent": {
          "desc": "Loads a trail component by id via saveSystem.",
          "params": {
            "id": {
              "type": "any",
              "desc": "component identifier"
            }
          },
          "returns": [
            {
              "type": "table|nil",
              "desc": "loaded trail"
            }
          ]
        },
        "loadBoundaryComponent": {
          "desc": "Loads a boundary component by id via saveSystem.",
          "params": {
            "id": {
              "type": "any",
              "desc": "component identifier"
            }
          },
          "returns": [
            {
              "type": "table|nil",
              "desc": "loaded boundary"
            }
          ]
        },
        "loadPathnodeComponent": {
          "desc": "Loads a path component by id via saveSystem.",
          "params": {
            "id": {
              "type": "any",
              "desc": "component identifier"
            }
          },
          "returns": [
            {
              "type": "table|nil",
              "desc": "loaded path"
            }
          ]
        },
        "saveTrailComponent": {
          "desc": "Renames the trail (trail.name = name) then records it as a component via saveSystem.",
          "params": {
            "name": {
              "type": "string",
              "desc": "name, non-empty"
            },
            "trail": {
              "type": "table",
              "desc": "trail to save"
            }
          },
          "returns": [
            {
              "type": "boolean",
              "desc": "success"
            },
            {
              "type": "any",
              "desc": "saveSystem result"
            }
          ]
        },
        "saveBoundaryComponent": {
          "desc": "Renames the boundary then records it as a component via saveSystem.",
          "params": {
            "name": {
              "type": "string",
              "desc": "name, non-empty"
            },
            "boundary": {
              "type": "table",
              "desc": "boundary"
            }
          },
          "returns": [
            {
              "type": "boolean",
              "desc": "success"
            },
            {
              "type": "any",
              "desc": "saveSystem result"
            }
          ]
        },
        "savePathnodeComponent": {
          "desc": "Renames the path then records it as a component via saveSystem.",
          "params": {
            "name": {
              "type": "string",
              "desc": "name, non-empty"
            },
            "path": {
              "type": "table",
              "desc": "path"
            }
          },
          "returns": [
            {
              "type": "boolean",
              "desc": "success"
            },
            {
              "type": "any",
              "desc": "saveSystem result"
            }
          ]
        },
        "deleteTrailComponent": {
          "desc": "Deletes a trail component via saveSystem.",
          "params": {
            "id": {
              "type": "any",
              "desc": "component identifier"
            }
          }
        },
        "deleteBoundaryComponent": {
          "desc": "Deletes a boundary component via saveSystem.",
          "params": {
            "id": {
              "type": "any",
              "desc": "component identifier"
            }
          }
        },
        "deletePathnodeComponent": {
          "desc": "Deletes a path component via saveSystem.",
          "params": {
            "id": {
              "type": "any",
              "desc": "component identifier"
            }
          }
        },
        "exportPreset": {
          "desc": "Writes a preset (complete table) to an independent JSON file.",
          "params": {
            "category": {
              "type": "string",
              "desc": "trails, boundaries or pathnodes"
            },
            "name": {
              "type": "string",
              "desc": "preset name"
            },
            "filepath": {
              "type": "string",
              "desc": "destination file"
            }
          },
          "returns": [
            {
              "type": "boolean",
              "desc": "success"
            },
            {
              "type": "string|nil",
              "desc": "filepath"
            }
          ]
        },
        "importPreset": {
          "desc": "Reads a preset file, checks name, category and data, adds it to the category (overwrites a preset of the same name) and saves.",
          "params": {
            "filepath": {
              "type": "string",
              "desc": "file to read"
            },
            "category": {
              "type": "string",
              "desc": "expected category"
            }
          },
          "returns": [
            {
              "type": "boolean",
              "desc": "success"
            },
            {
              "type": "string|nil",
              "desc": "presets file"
            }
          ]
        },
        "getShowSaveBoundaryDialog": {
          "desc": "Indicates whether the boundary save dialog is displayed.",
          "returns": [
            {
              "type": "boolean",
              "desc": "state"
            }
          ]
        },
        "setShowSaveBoundaryDialog": {
          "desc": "Shows/hides the boundary save dialog.",
          "params": {
            "show": {
              "type": "boolean",
              "desc": "show"
            }
          }
        },
        "getShowSavePathnodeDialog": {
          "desc": "Indicates whether the path save dialog is displayed.",
          "returns": [
            {
              "type": "boolean",
              "desc": "state"
            }
          ]
        },
        "setShowSavePathnodeDialog": {
          "desc": "Shows/hides the path save dialog.",
          "params": {
            "show": {
              "type": "boolean",
              "desc": "show"
            }
          }
        },
        "getShowSaveTrailDialog": {
          "desc": "Indicates whether the trail save dialog is displayed.",
          "returns": [
            {
              "type": "boolean",
              "desc": "state"
            }
          ]
        },
        "setShowSaveTrailDialog": {
          "desc": "Shows/hides the trail save dialog.",
          "params": {
            "show": {
              "type": "boolean",
              "desc": "show"
            }
          }
        },
        "getShowPresetManager": {
          "desc": "Indicates whether the component management window is displayed.",
          "returns": [
            {
              "type": "boolean",
              "desc": "state"
            }
          ]
        },
        "setShowPresetManager": {
          "desc": "Shows/hides the management window and synchronizes the ImGui pointer.",
          "params": {
            "show": {
              "type": "boolean",
              "desc": "show"
            }
          }
        },
        "getShowPresetManagerPtr": {
          "desc": "Returns the ImGui BoolPtr linked to the management window.",
          "returns": [
            {
              "type": "userdata",
              "desc": "im.BoolPtr"
            }
          ]
        },
        "getBoundaryPresetName": {
          "desc": "Returns the ImGui buffer (256 characters) of the name entered for a boundary.",
          "returns": [
            {
              "type": "userdata",
              "desc": "im.ArrayChar"
            }
          ]
        },
        "getPathnodePresetName": {
          "desc": "Returns the ImGui buffer of the name entered for a path.",
          "returns": [
            {
              "type": "userdata",
              "desc": "im.ArrayChar"
            }
          ]
        },
        "getTrailPresetName": {
          "desc": "Returns the ImGui buffer of the name entered for a trail.",
          "returns": [
            {
              "type": "userdata",
              "desc": "im.ArrayChar"
            }
          ]
        },
        "drawMenu": {
          "desc": "Draws the ImGui submenus listing the trail, boundary and path components (click = load into crawlData) and the \"Manage Components...\" entry. Stores crawlData, trails and waypoints for the dialogs.",
          "params": {
            "crawlData": {
              "type": "table",
              "desc": "current crawl data (trails field)"
            },
            "trails": {
              "type": "table",
              "desc": "editor trails module"
            },
            "waypoints": {
              "type": "table",
              "desc": "editor waypoints module"
            }
          },
          "internal": true
        },
        "drawDialogs": {
          "desc": "Draws the ImGui save windows (boundary, path, trail) and the component manager; called every frame by the Crawl editor.",
          "internal": true
        }
      }
    }
  }
}
