{
  "path": "lua/ge/extensions/editor/toolUtilities/render/spheres.lua",
  "module": "Drawing of debug spheres and handles for the spline editing tools (from the old render.lua). Leaf module: depends on utils/debugDraw and the shared style. The radius is proportional to the distance to the camera (constant apparent size up to 60 m, then fixed world size), via getSphereScale which the render/spline, transport and graph modules reuse. Contains nodes, junctions, bar and curve handles, highlights (hover, selection, pulsing over time) and \"X-ray\" ghosts without depth test.",
  "notes": [
    "The \"Culled\" variants (and most node drawings) only draw within 600 m of the camera; drawSphereCursor and drawSphereImmediate are not filtered.",
    "The highlights pulse with os.clock() according to the style frequencies (highlightPulseHz, highlightHoverPulseHz).",
    "The \"Fixed\" functions take a fixed world radius instead of the distance-linked scale.",
    "Ghosts (Ghost) and highlights are drawn without depth test: visible through the terrain."
  ],
  "functions": {
    "getSphereScale": {
      "desc": "Sphere scale factor for a distance d to the camera: d capped at 60 m, multiplied by a slope (1/sqrt(30) * 0.8).",
      "params": {
        "d": {
          "type": "number",
          "desc": "Camera-to-point distance in meters."
        }
      },
      "returns": [
        {
          "type": "number",
          "desc": "Base scale."
        }
      ],
      "internal": false
    },
    "drawSphereCulled": {
      "desc": "Sphere at the distance-linked scale, if the point is within 600 m.",
      "params": {
        "p": {
          "type": "vec3",
          "desc": "Center."
        },
        "scale": {
          "type": "number",
          "desc": "Scale multiplier."
        },
        "col": {
          "type": "integer",
          "desc": "Packed color."
        }
      },
      "returns": []
    },
    "drawSphereImmediate": {
      "desc": "Sphere at the distance-linked scale, without distance filtering.",
      "params": {
        "p": {
          "type": "vec3",
          "desc": "Center."
        },
        "scale": {
          "type": "number",
          "desc": "Scale multiplier."
        },
        "col": {
          "type": "integer",
          "desc": "Packed color."
        }
      },
      "returns": []
    },
    "drawSphereRib": {
      "desc": "Rib handle: halo then core.",
      "params": {
        "p": {
          "type": "vec3",
          "desc": "Center."
        }
      },
      "returns": []
    },
    "drawSphereBar": {
      "desc": "Bar handle (halo then core).",
      "params": {
        "p": {
          "type": "vec3",
          "desc": "Center."
        }
      },
      "returns": []
    },
    "drawSphereBarHover": {
      "desc": "Hovered bar handle: larger pulsing halo.",
      "params": {
        "p": {
          "type": "vec3",
          "desc": "Center."
        }
      },
      "returns": []
    },
    "drawSphereBarGhost": {
      "desc": "X-ray ghost of the bar handle.",
      "params": {
        "p": {
          "type": "vec3",
          "desc": "Center."
        }
      },
      "returns": []
    },
    "drawSphereCornerHandleGhost": {
      "desc": "X-ray ghost of the corner handle.",
      "params": {
        "p": {
          "type": "vec3",
          "desc": "Center."
        }
      },
      "returns": []
    },
    "drawSphereCurveHandle": {
      "desc": "Curve apex handle (edge bending, corner radius), green by default.",
      "params": {
        "p": {
          "type": "vec3",
          "desc": "Center."
        }
      },
      "returns": []
    },
    "drawSphereCurveHandleHover": {
      "desc": "Hovered curve handle (pulsing halo).",
      "params": {
        "p": {
          "type": "vec3",
          "desc": "Center."
        }
      },
      "returns": []
    },
    "drawSphereCurveHandleCol": {
      "desc": "Curve handle with core and halo colors chosen by the tool: stable point with soft halo.",
      "params": {
        "p": {
          "type": "vec3",
          "desc": "Center."
        },
        "coreCol": {
          "type": "integer",
          "desc": "Core color."
        },
        "glowCol": {
          "type": "integer",
          "desc": "Halo color."
        }
      },
      "returns": []
    },
    "drawSphereCurveHandleHoverCol": {
      "desc": "Hovered version of drawSphereCurveHandleCol: larger, brighter, pulsing halo.",
      "params": {
        "p": {
          "type": "vec3",
          "desc": "Center."
        },
        "coreCol": {
          "type": "integer",
          "desc": "Core color."
        },
        "glowCol": {
          "type": "integer",
          "desc": "Halo color."
        }
      },
      "returns": []
    },
    "drawSphereHighlight": {
      "desc": "Node highlight (colourHighlight, no depth test), filtered at 600 m.",
      "params": {
        "p": {
          "type": "vec3",
          "desc": "Center."
        }
      },
      "returns": []
