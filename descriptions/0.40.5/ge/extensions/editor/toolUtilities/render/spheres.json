    "drawSelectedNavGraphNode": {
      "desc": "Large pulsing node of the selected navigation graph.",
      "params": {
        "p": {
          "type": "vec3",
          "desc": "Center."
        }
      },
      "returns": []
    },
    "drawHoverNavGraphNode": {
      "desc": "Pulsing halo of a hovered navGraph node.",
      "params": {
        "p": {
          "type": "vec3",
          "desc": "Center."
        }
      },
      "returns": []
