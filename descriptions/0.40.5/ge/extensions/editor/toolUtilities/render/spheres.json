    "drawSphereHighlightSelectedFixed": {
      "desc": "Pulsing selection highlight with fixed world radius.",
      "params": {
        "p": {
          "type": "vec3",
          "desc": "Center."
        },
        "radius": {
          "type": "number",
          "desc": "Base radius in meters."
        }
      },
      "returns": []
    },
    "drawPathNode": {
