      "params": {
        "p": {
          "type": "vec3",
          "desc": "Center."
        }
      },
      "returns": []
    },
    "drawSphereJunction": {
      "desc": "Junction center (halo then core).",
      "params": {
        "p": {
          "type": "vec3",
          "desc": "Center."
        }
      },
      "returns": []
