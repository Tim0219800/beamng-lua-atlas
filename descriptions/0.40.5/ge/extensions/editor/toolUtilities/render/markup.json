{
  "path": "lua/ge/extensions/editor/toolUtilities/render/markup.lua",
  "module": "Étiquettes de texte en 3D pour les outils d'édition de splines (issu de l'ancien render.lua). Fournit les primitives de texte (filtré ou non par distance, couleurs normales ou inversées, via debugDraw.drawTextAdvanced) et toutes les étiquettes prêtes à l'emploi : invites du curseur (« Click To Add Node »), noms, longueurs, largeurs, élévations, vitesses, distances d'obstacle. Les textes sont en anglais dans le code.",
  "notes": [
    "Les étiquettes répétitives (noms, longueurs, valeurs par nœud) sont filtrées à 250 m de la caméra ; les invites du curseur et quelques étiquettes importantes (élévation, nom sélectionné) ne le sont pas pour rester lisibles de loin.",
    "drawMarkupCulledAlwaysShow est identique à drawMarkupCulled dans le code (même seuil de 250 m) : le nom ne reflète pas un comportement différent.",
    "Toutes les fonctions prennent pos (vec3) comme position monde du texte."
  ],
  "functions": {
    "drawMarkupCulled": {"desc": "Texte à pos, affiché seulement à moins de 250 m de la caméra.", "params": {"pos": {"type": "vec3", "desc": "Position."}, "text": {"type": "string", "desc": "Texte."}}, "returns": []},
    "drawMarkupCulledAlwaysShow": {"desc": "Même comportement que drawMarkupCulled (filtre 250 m).", "params": {"pos": {"type": "vec3", "desc": "Position."}, "text": {"type": "string", "desc": "Texte."}}, "returns": []},
    "drawMarkupUnculled": {"desc": "Texte sans filtre de distance, pour les étiquettes à garder lisibles à n'importe quelle distance.", "params": {"pos": {"type": "vec3", "desc": "Position."}, "text": {"type": "string", "desc": "Texte."}}, "returns": []},
    "drawMarkupCulledInvertedCols": {"desc": "Texte filtré à 250 m avec couleurs de texte et de fond inversées.", "params": {"pos": {"type": "vec3", "desc": "Position."}, "text": {"type": "string", "desc": "Texte."}}, "returns": []},
    "markupText": {"desc": "Texte simple filtré.", "params": {"pos": {"type": "vec3", "desc": "Position."}, "text": {"type": "string", "desc": "Texte."}}, "returns": []},
    "markupPrompt": {"desc": "Invite du curseur : texte non filtré.", "params": {"pos": {"type": "vec3", "desc": "Position."}, "text": {"type": "string", "desc": "Texte."}}, "returns": []},
    "markupLines": {"desc": "Plusieurs lignes jointes par saut de ligne en une seule étiquette filtrée. Sans effet si la liste est vide.", "params": {"pos": {"type": "vec3", "desc": "Position."}, "lines": {"type": "string[]", "desc": "Lignes de texte."}}, "returns": []},
    "markupStack": {"desc": "Dessine chaque ligne comme une étiquette séparée à la même position (elles se superposent).", "params": {"pos": {"type": "vec3", "desc": "Position."}, "lines": {"type": "string[]", "desc": "Lignes de texte."}}, "returns": []},
    "markupDrag": {"desc": "Invite « [Click To Select, Drag To Move] ».", "params": {"pos": {"type": "vec3", "desc": "Position."}}, "returns": []},
    "markupLinkedTip": {"desc": "Invite « [Linked — Drag Away Or Use Detach Button] ».", "params": {"pos": {"type": "vec3", "desc": "Position."}}, "returns": []},
    "markupSelectSpline": {"desc": "Invite « [Click To Select Spline] ».", "params": {"pos": {"type": "vec3", "desc": "Position."}}, "returns": []},
    "markupSelectedSplineDisabled": {"desc": "Invite « [Spline Disabled. Cannot Edit] ».", "params": {"pos": {"type": "vec3", "desc": "Position."}}, "returns": []},
    "markupSelectOrAdd": {"desc": "Invite « [Select A Spline Or Click 'Add'] ».", "params": {"pos": {"type": "vec3", "desc": "Position."}}, "returns": []},
    "markupAddNode": {"desc": "Invite « [Click To Add Node] ».", "params": {"pos": {"type": "vec3", "desc": "Position."}}, "returns": []},
    "markupInsertNode": {"desc": "Invite « [Click To Insert Node] ».", "params": {"pos": {"type": "vec3", "desc": "Position."}}, "returns": []},
    "markupRoadLength": {"desc": "Étiquette « [Length = x.xx m] » en couleurs inversées.", "params": {"pos": {"type": "vec3", "desc": "Position."}, "l": {"type": "number", "desc": "Longueur en mètres."}}, "returns": []},
    "markupAdjustWidth": {"desc": "Invite de réglage de largeur (glisser, SHIFT pour la précision).", "params": {"pos": {"type": "vec3", "desc": "Position."}}, "returns": []},
    "markupAdjustBar": {"desc": "Invite de réglage de hauteur (glisser, SHIFT pour la précision).", "params": {"pos": {"type": "vec3", "desc": "Position."}}, "returns": []},
    "markupAdjustDepth": {"desc": "Invite de réglage de profondeur (glisser, SHIFT pour la précision).", "params": {"pos": {"type": "vec3", "desc": "Position."}}, "returns": []},
    "markupWidthDisplay": {"desc": "Affiche « [Width = x.xx m] ».", "params": {"pos": {"type": "vec3", "desc": "Position."}, "w": {"type": "number", "desc": "Largeur en mètres."}}, "returns": []},
    "markupDepthDisplay": {"desc": "Affiche « [d = x.xx m] ».", "params": {"pos": {"type": "vec3", "desc": "Position."}, "d": {"type": "number", "desc": "Profondeur en mètres."}}, "returns": []},
    "markupAddPolygonNode": {"desc": "Invite « [Click To Add Node. Double-Click To Finish] ».", "params": {"pos": {"type": "vec3", "desc": "Position."}}, "returns": []},
    "markupStart": {"desc": "Étiquette « [Start] » en couleurs inversées.", "params": {"pos": {"type": "vec3", "desc": "Position."}}, "returns": []},
    "markupEnd": {"desc": "Étiquette « [End] » en couleurs inversées.", "params": {"pos": {"type": "vec3", "desc": "Position."}}, "returns": []},
    "markupAddPairLeft": {"desc": "Invite « [Add Pair: Click 1st Node] ».", "params": {"pos": {"type": "vec3", "desc": "Position."}}, "returns": []},
    "markupPairFirstNode": {"desc": "Étiquette « [Pair: First Node] ».", "params": {"pos": {"type": "vec3", "desc": "Position."}}, "returns": []},
    "markupPairSecondNode": {"desc": "Invite : clic gauche ajoute le 2e nœud, clic droit annule la paire.", "params": {"pos": {"type": "vec3", "desc": "Position."}}, "returns": []},
    "markupNode1": {"desc": "Étiquette « Node [1] ».", "params": {"pos": {"type": "vec3", "desc": "Position."}}, "returns": []},
    "markupNode2": {"desc": "Étiquette « Node [2] ».", "params": {"pos": {"type": "vec3", "desc": "Position."}}, "returns": []},
    "markupNode3": {"desc": "Étiquette « Node [3] ».", "params": {"pos": {"type": "vec3", "desc": "Position."}}, "returns": []},
    "markupSplineName": {"desc": "Nom de spline entre crochets, filtré à 250 m.", "params": {"pos": {"type": "vec3", "desc": "Position."}, "str": {"type": "string", "desc": "Nom."}}, "returns": []},
    "markupSelectedName": {"desc": "Même étiquette pour l'élément en cours d'édition, non filtrée.", "params": {"pos": {"type": "vec3", "desc": "Position."}, "str": {"type": "string", "desc": "Nom."}}, "returns": []},
    "markupActiveSurf": {"desc": "Étiquette « [Active Surface (2D)] ».", "params": {"pos": {"type": "vec3", "desc": "Position."}}, "returns": []},
    "markupVolume": {"desc": "Étiquette « [Active Volume (3D)] ».", "params": {"pos": {"type": "vec3", "desc": "Position."}}, "returns": []},
    "markupElevation": {"desc": "Affiche « [Elevation = x.xx m] » sans filtre de distance (une seule, sur le nœud sélectionné).", "params": {"pos": {"type": "vec3", "desc": "Position."}, "elev": {"type": "number", "desc": "Élévation en mètres."}}, "returns": []},
    "markupTwistAngle": {"desc": "Affiche « [Twist Angle = x.xx deg] ».", "params": {"pos": {"type": "vec3", "desc": "Position."}, "angleDeg": {"type": "number", "desc": "Angle en degrés."}}, "returns": []},
    "markupVelocity": {"desc": "Affiche « [Limit|Velocity = x.xx unité] ».", "params": {"pos": {"type": "vec3", "desc": "Position."}, "vel": {"type": "number", "desc": "Valeur."}, "isBarsLimit": {"type": "boolean", "desc": "true : libellé Limit, false : Velocity."}, "unitsStr": {"type": "string", "desc": "Unité affichée."}}, "returns": []},
    "markupGraphNodeHover": {"desc": "Invite « [Click To Add/Remove From Path] ».", "params": {"pos": {"type": "vec3", "desc": "Position."}}, "returns": []},
    "markupGraphFreeSpace": {"desc": "Invite « [Click NavGraph Node To Add To Path] ».", "params": {"pos": {"type": "vec3", "desc": "Position."}}, "returns": []},
    "markupPathNode": {"desc": "Étiquette « Path Node [i] ».", "params": {"pos": {"type": "vec3", "desc": "Position."}, "i": {"type": "integer", "desc": "Numéro du nœud."}}, "returns": []},
    "markupLoop": {"desc": "Invite « [Hold CTRL + Drop To Form Loop] ». La suite masterSpline conditionne jonctions et boucles à CTRL : l'aperçu s'affiche dès qu'un candidat existe, mais le relâchement ne valide que CTRL enfoncé.", "params": {"pos": {"type": "vec3", "desc": "Position."}}, "returns": []},
    "markupJoin": {"desc": "Invite « [Hold CTRL + Drop To Join] ».", "params": {"pos": {"type": "vec3", "desc": "Position."}}, "returns": []},
    "markupLinkedSplineCannotAdd": {"desc": "Message « [Linked Spline - Cannot Add Nodes] ».", "params": {"pos": {"type": "vec3", "desc": "Position."}}, "returns": []},
    "markupLoopedSplineCannotAdd": {"desc": "Message « [Looped Spline - Cannot Add Here] ».", "params": {"pos": {"type": "vec3", "desc": "Position."}}, "returns": []},
    "markupObstacleDistance": {"desc": "Affiche « [Obstacle: x.x m] ».", "params": {"pos": {"type": "vec3", "desc": "Position."}, "dist": {"type": "number", "desc": "Distance en mètres."}}, "returns": []},
    "markupObstacleDistanceWithElevation": {"desc": "Affiche la distance à l'obstacle et l'écart d'altitude dZ.", "params": {"pos": {"type": "vec3", "desc": "Position."}, "dist": {"type": "number", "desc": "Distance en mètres."}, "elevDiff": {"type": "number", "desc": "Écart d'altitude en mètres."}}, "returns": []},
    "markupAngleAndDistance": {"desc": "Affiche distance (m) et angle (converti de radians en degrés).", "params": {"pos": {"type": "vec3", "desc": "Position."}, "dist": {"type": "number", "desc": "Distance en mètres."}, "angleRad": {"type": "number", "desc": "Angle en radians."}}, "returns": []},
    "markupAngleDistanceWithElevation": {"desc": "Affiche distance, angle (degrés) et écart d'altitude dZ.", "params": {"pos": {"type": "vec3", "desc": "Position."}, "dist": {"type": "number", "desc": "Distance en mètres."}, "angleRad": {"type": "number", "desc": "Angle en radians."}, "elevDiff": {"type": "number", "desc": "Écart d'altitude en mètres."}}, "returns": []}
  }
}
