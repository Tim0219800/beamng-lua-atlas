        "text": {
          "type": "string",
          "desc": "Text."
        }
      },
      "returns": []
    },
    "markupLines": {
      "desc": "Several lines joined by line breaks into a single filtered label. No effect if the list is empty.",
      "params": {
        "pos": {
          "type": "vec3",
          "desc": "Position."
        },
        "lines": {
          "type": "string[]",
          "desc": "Lines of text."
        }
      },
      "returns": []
    },
    "markupStack": {
      "desc": "Draws each line as a separate label at the same position (they overlap).",
