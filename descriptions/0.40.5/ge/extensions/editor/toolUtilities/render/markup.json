{
  "path": "lua/ge/extensions/editor/toolUtilities/render/markup.lua",
  "module": "3D text labels for the spline editing tools (from the old render.lua). Provides the text primitives (filtered or not by distance, normal or inverted colors, via debugDraw.drawTextAdvanced) and all the ready-made labels: cursor prompts (\"Click To Add Node\"), names, lengths, widths, elevations, speeds, obstacle distances. The texts are in English in the code.",
  "notes": [
    "The repetitive labels (names, lengths, per-node values) are filtered at 250 m from the camera; the cursor prompts and a few important labels (elevation, selected name) are not, to stay readable from afar.",
    "drawMarkupCulledAlwaysShow is identical to drawMarkupCulled in the code (same 250 m threshold): the name does not reflect a different behavior.",
    "All functions take pos (vec3) as the world position of the text."
  ],
  "functions": {
    "drawMarkupCulled": {
      "desc": "Text at pos, displayed only within 250 m of the camera.",
      "params": {
        "pos": {
          "type": "vec3",
          "desc": "Position."
        },
        "text": {
          "type": "string",
          "desc": "Text."
        }
      },
      "returns": []
    },
    "drawMarkupCulledAlwaysShow": {
      "desc": "Same behavior as drawMarkupCulled (250 m filter).",
      "params": {
        "pos": {
          "type": "vec3",
          "desc": "Position."
        },
        "text": {
          "type": "string",
          "desc": "Text."
        }
      },
      "returns": []
    },
    "drawMarkupUnculled": {
      "desc": "Text without distance filter, for labels to keep readable at any distance.",
      "params": {
        "pos": {
          "type": "vec3",
          "desc": "Position."
        },
        "text": {
          "type": "string",
          "desc": "Text."
        }
      },
      "returns": []
    },
    "drawMarkupCulledInvertedCols": {
      "desc": "Text filtered at 250 m with inverted text and background colors.",
      "params": {
        "pos": {
          "type": "vec3",
          "desc": "Position."
        },
        "text": {
          "type": "string",
          "desc": "Text."
        }
      },
      "returns": []
    },
    "markupText": {
      "desc": "Simple filtered text.",
      "params": {
        "pos": {
          "type": "vec3",
          "desc": "Position."
        },
        "text": {
          "type": "string",
          "desc": "Text."
        }
      },
      "returns": []
