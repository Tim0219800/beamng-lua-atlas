{
  "path": "lua/ge/extensions/editor/toolUtilities/sweep.lua",
  "module": "Sweep geometry (loft) for the editor's building tools: a piece is a section (2D polygon in (s, t) coordinates) and a path of frames. Used to cut gutters, pipes, elbows, ducts, risers. Writes faces into an accumulator `p` via meshPart.face4 and meshPart.face3. A frame is an origin and two axes: the section point (s, t) lands at o + a*s + b*t, so the same section swept along +X, +Z or a turn comes out correctly oriented without being rewritten.",
  "usage": "local sweep = require('editor/toolUtilities/sweep')\nlocal sect = sweep.circleSection(0.05, 12)\nlocal path = sweep.alongZ(0, 3)\nsweep.loft(p, sect, path, 1.0)\nsweep.cap(p, sect, path[1], -1, 1.0)\nsweep.cap(p, sect, path[2], 1, 1.0)",
  "notes": [
    "A frame is a table { ox, oy, oz, ax, ay, az, bx, by, bz }; a section point is { s, t }.",
    "The winding direction of the section determines the face normals: providing the same section reversed (reversed) turns the faces inward, useful for a bore.",
    "cap uses a triangle fan: the section must be convex, otherwise it must be butted against the next piece.",
    "The uv parameter is the texture coordinate scale (U follows the arc length of the section, V the distance traveled)."
  ],
  "functions": {
    "P": {
      "desc": "Creates a point { x, y, z }.",
      "params": {
        "x": {
          "type": "number",
          "desc": "X."
        },
        "y": {
          "type": "number",
          "desc": "Y."
        },
        "z": {
          "type": "number",
          "desc": "Z."
        }
      },
      "returns": [
        {
          "type": "table",
          "desc": "Point { x, y, z }."
        }
      ]
    },
    "fr": {
      "desc": "A frame of a swept path: the section's (s, t) lands at o + a*s + b*t.",
      "params": {
        "ox": {
          "type": "number",
          "desc": "Origin X."
        },
        "oy": {
          "type": "number",
          "desc": "Origin Y."
        },
        "oz": {
          "type": "number",
          "desc": "Origin Z."
        },
        "ax": {
          "type": "number",
          "desc": "Axis a, X."
        },
        "ay": {
          "type": "number",
          "desc": "Axis a, Y."
        },
        "az": {
          "type": "number",
          "desc": "Axis a, Z."
        },
        "bx": {
          "type": "number",
          "desc": "Axis b, X."
        },
        "by": {
          "type": "number",
          "desc": "Axis b, Y."
        },
        "bz": {
          "type": "number",
          "desc": "Axis b, Z."
        }
      },
      "returns": [
        {
          "type": "table",
          "desc": "Frame."
        }
      ]
    },
    "at": {
      "desc": "World point corresponding to the section point (s, t) in frame f.",
      "params": {
        "f": {
          "type": "table",
          "desc": "Frame."
        },
        "s": {
          "type": "number",
          "desc": "Coordinate s."
        },
        "t": {
          "type": "number",
          "desc": "Coordinate t."
        }
      },
      "returns": [
        {
          "type": "table",
          "desc": "Point { x, y, z }."
        }
      ]
    },
    "loft": {
      "desc": "Sweeps a closed section along a path of frames: one quad per section edge and per step. The UVs follow the section's arc length across and the distance traveled lengthwise, so a piece stretched by the placer stays tiled-textured.",
      "params": {
        "p": {
          "type": "table",
          "desc": "Face accumulator (meshPart)."
        },
        "sect": {
          "type": "table",
          "desc": "Closed section, list of { s, t }."
        },
        "path": {
          "type": "table",
          "desc": "List of frames."
        },
        "uv": {
          "type": "number",
          "desc": "UV scale."
        }
      },
      "returns": []
    },
    "cap": {
      "desc": "Closes one end of a loft, oriented in the path direction (sgn 1) or the opposite direction. Fan triangulation, so convex section only.",
      "params": {
        "p": {
          "type": "table",
          "desc": "Face accumulator."
        },
        "sect": {
          "type": "table",
          "desc": "Convex section."
        },
        "f": {
          "type": "table",
          "desc": "Frame of the end."
        },
        "sgn": {
          "type": "integer",
          "desc": "1 or -1: normal direction."
        },
        "uv": {
          "type": "number",
          "desc": "UV scale."
        }
      },
      "returns": []
    },
    "ring": {
      "desc": "The flat strip between two sections with the same number of points, at one frame: the mouth of an open pipe.",
      "params": {
        "p": {
          "type": "table",
          "desc": "Face accumulator."
        },
        "inner": {
          "type": "table",
          "desc": "Inner section."
        },
        "outer": {
          "type": "table",
          "desc": "Outer section."
        },
        "f": {
          "type": "table",
          "desc": "Frame."
        },
        "sgn": {
          "type": "integer",
          "desc": "Normal direction (1 or -1)."
        },
        "uv": {
          "type": "number",
          "desc": "UV scale."
        }
      },
      "returns": []
    },
    "taper": {
      "desc": "Sweeps BETWEEN two sections with the same number of points, one frame each: a taper from the mouth to the throat. Same quad per edge as the straight loft, but each end has its own shape.",
      "params": {
        "p": {
          "type": "table",
          "desc": "Face accumulator."
        },
        "s0": {
          "type": "table",
          "desc": "Start section."
        },
        "s1": {
          "type": "table",
          "desc": "End section (same number of points)."
        },
        "f0": {
          "type": "table",
          "desc": "Start frame."
        },
        "f1": {
          "type": "table",
          "desc": "End frame."
        },
        "uv": {
          "type": "number",
          "desc": "UV scale."
        }
      },
      "returns": []
    },
    "alongX": {
      "desc": "Run along +X carrying a section laid out in (y, z).",
      "params": {
        "x0": {
          "type": "number",
          "desc": "Start X."
        },
        "x1": {
          "type": "number",
          "desc": "End X."
        }
      },
      "returns": [
        {
          "type": "table",
          "desc": "Two frames."
        }
      ]
    },
    "alongY": {
      "desc": "Run along +Y carrying a section laid out in (x, z).",
      "params": {
        "y0": {
          "type": "number",
          "desc": "Start Y."
        },
        "y1": {
          "type": "number",
          "desc": "End Y."
        }
      },
      "returns": [
        {
          "type": "table",
          "desc": "Two frames."
        }
      ]
    },
    "alongZ": {
      "desc": "Upward run along +Z carrying a section laid out in (x, y), optionally offset from the axis.",
      "params": {
        "z0": {
          "type": "number",
          "desc": "Start Z."
        },
        "z1": {
          "type": "number",
          "desc": "End Z."
        },
        "cx": {
          "type": "number|nil",
          "desc": "X offset (0 by default)."
        },
        "cy": {
          "type": "number|nil",
          "desc": "Y offset (0 by default)."
        }
      },
      "returns": [
        {
          "type": "table",
          "desc": "Two frames."
        }
      ]
    },
    "boxX": {
      "desc": "Closed box (loft plus two caps) extended along X, section in (y, z).",
      "params": {
        "p": {
          "type": "table",
          "desc": "Face accumulator."
        },
        "x0": {
          "type": "number",
          "desc": "X min."
        },
        "x1": {
          "type": "number",
          "desc": "X max."
        },
        "y0": {
          "type": "number",
          "desc": "Y min."
        },
        "y1": {
          "type": "number",
          "desc": "Y max."
        },
        "z0": {
          "type": "number",
          "desc": "Min Z."
        },
        "z1": {
          "type": "number",
          "desc": "Max Z."
        },
        "uv": {
          "type": "number",
          "desc": "UV scale."
        }
      },
      "returns": []
    },
    "boxZ": {
      "desc": "The same box, stood upright and swept on Z. A loft lays U around the section and V along the path: the two lay a face's texture at right angles to each other. Use it for a material that has a DIRECTION (such as brick, whose courses come out upright with boxX).",
      "params": {
        "p": {
          "type": "table",
          "desc": "Face accumulator."
        },
        "x0": {
          "type": "number",
          "desc": "X min."
        },
        "x1": {
          "type": "number",
          "desc": "X max."
        },
        "y0": {
          "type": "number",
          "desc": "Y min."
        },
        "y1": {
          "type": "number",
          "desc": "Y max."
        },
        "z0": {
          "type": "number",
          "desc": "Min Z."
        },
        "z1": {
          "type": "number",
          "desc": "Max Z."
        },
        "uv": {
          "type": "number",
          "desc": "UV scale."
        }
      },
      "returns": []
    },
    "circleSection": {
      "desc": "Circular section of radius r with n points, around the origin.",
      "params": {
        "r": {
          "type": "number",
          "desc": "Radius."
        },
        "n": {
          "type": "integer",
          "desc": "Number of points."
        }
      },
      "returns": [
        {
          "type": "table",
          "desc": "List of { s, t }."
        }
      ]
    },
    "boxSection": {
      "desc": "Square section around the origin, or rectangular if a second half-size is given.",
      "params": {
        "hx": {
          "type": "number",
          "desc": "Half-size in s."
        },
        "hy": {
          "type": "number|nil",
          "desc": "Half-size in t (= hx by default)."
        }
      },
      "returns": [
        {
          "type": "table",
          "desc": "4 points."
        }
      ]
    },
    "octSection": {
      "desc": "Regular OCTAGON around the origin; `m` goes from the center to each of the eight flats.",
      "params": {
        "m": {
          "type": "number",
          "desc": "Distance from the center to a flat."
        }
      },
      "returns": [
        {
          "type": "table",
          "desc": "8 points."
        }
      ]
    },
    "octPost": {
      "desc": "Octagonal post standing on +Z between two heights, closed at both ends (loft plus two caps).",
      "params": {
        "p": {
          "type": "table",
          "desc": "Face accumulator."
        },
        "m": {
          "type": "number",
          "desc": "Distance from the center to a flat."
        },
        "z0": {
          "type": "number",
          "desc": "Start height."
        },
        "z1": {
          "type": "number",
          "desc": "End height."
        },
        "uv": {
          "type": "number",
          "desc": "UV scale."
        }
      },
      "returns": []
    },
    "reversed": {
      "desc": "Returns the section traversed in the opposite direction (the faces will look inward).",
      "params": {
        "sect": {
          "type": "table",
          "desc": "Section."
        }
      },
      "returns": [
        {
          "type": "table",
          "desc": "New reversed section."
        }
      ]
    },
    "rect8": {
      "desc": "Rectangle written as EIGHT points (not four), taken at the same angles as a circle with the same count, to close a flat plate from one section to the other. Centered at (0, cy).",
      "params": {
        "hx": {
          "type": "number",
          "desc": "Half-width."
        },
        "hy": {
          "type": "number",
          "desc": "Half-height."
        },
        "cy": {
          "type": "number|nil",
          "desc": "Center offset in t (0 by default)."
        }
      },
      "returns": [
        {
          "type": "table",
          "desc": "8 points."
        }
      ]
    },
    "turnPath": {
      "desc": "Quarter turn in plan: enters along +X at the origin, exits toward `sy` on Y. The section is carried without unrolling, so a gutter stays straight in the turn.",
      "params": {
        "R": {
          "type": "number",
          "desc": "Turn radius."
        },
        "sy": {
          "type": "number",
          "desc": "Side of the turn on Y (sign)."
        },
        "ang": {
          "type": "number",
          "desc": "Total angle in radians."
        },
        "segs": {
          "type": "integer",
          "desc": "Number of segments."
        }
      },
      "returns": [
        {
          "type": "table",
          "desc": "segs + 1 frames."
        }
      ]
    },
    "kinkPath": {
      "desc": "An elbow in the vertical plane: enters along +Z at the origin, exits leaning toward -Y (toward the outside of the wall).",
      "params": {
        "R": {
          "type": "number",
          "desc": "Elbow radius."
        },
        "ang": {
          "type": "number",
          "desc": "Total angle in radians."
        },
        "segs": {
          "type": "integer",
          "desc": "Number of segments."
        }
      },
      "returns": [
        {
          "type": "table",
          "desc": "segs + 1 frames."
        }
      ]
    }
  }
}
