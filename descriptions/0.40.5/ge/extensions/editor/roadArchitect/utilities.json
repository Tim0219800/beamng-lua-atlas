{
  "path": "lua/ge/extensions/editor/roadArchitect/utilities.lua",
  "module": "Road Architect toolbox: drawing of debug spheres/lines, mouse detection on the terrain or on a node, road bounding box computations, file path manipulation, and many 2D/3D geometry functions (intersections, projections, circle through 3 points, angles, rotations, slerp). A modder can reuse the pure geometry functions; the drawing or mouse functions assume the editor is active.",
  "usage": "local util = extensions.editor_roadArchitect_utilities\nlocal p = util.intersection2Lines(vec3(0,0,0), vec3(10,0,0), vec3(5,-5,0), vec3(5,5,0))  -- vec3(5,0,0)\nlocal a = util.angleBetweenVecs2D(vec3(1,0,0), vec3(0,1,0))  -- pi/2",
  "notes": [
    "The 2D functions ignore the z coordinate. Angles are in radians.",
    "Functions that MODIFY their arguments: getRotationBetweenVecs normalizes v1 and v2 in place; rotateVecByQuaternion normalizes q in place.",
    "circle2DFrom3Points only returns the center (vec3 without radius); returns nil, nil if the points are collinear.",
    "getFilenameFromPath only splits on '/', whereas removeFileNameFromPath accepts '/' and '\\' and keeps the trailing separator.",
    "slerp: the angle is multiplied by t then used in sin((1-t)*theta): this is not the standard slerp formula, result to be checked before precise use (inferred from code).",
    "The drawing functions use dbgDraw and the distance to the camera: the sphere size is proportional to sqrt(distance)."
  ],
  "functions": {
    "drawSphere": {
      "desc": "Draws a debug sphere whose radius grows with sqrt(camera distance) to keep a roughly constant apparent size.",
      "params": {
        "pos": {
          "type": "vec3",
          "desc": "Center."
        }
      },
      "returns": []
    },
    "drawGroupSphere": {
      "desc": "Like drawSphere, with the group sphere color.",
      "params": {
        "pos": {
          "type": "vec3",
          "desc": "Center."
        }
      },
      "returns": []
    },
    "drawSphereHighlight": {
      "desc": "Highlight sphere (highlight color).",
      "params": {
        "pos": {
          "type": "vec3",
          "desc": "Center."
        }
      },
      "returns": []
    },
    "drawSphereHighlightRed": {
      "desc": "Red highlight sphere.",
      "params": {
        "pos": {
          "type": "vec3",
          "desc": "Center."
        }
      },
      "returns": []
    },
    "drawSphereHighlightPurple": {
      "desc": "Purple highlight sphere.",
      "params": {
        "pos": {
          "type": "vec3",
          "desc": "Center."
        }
      },
      "returns": []
    },
    "drawHighlightSphereRad": {
      "desc": "Highlight sphere of given radius.",
      "params": {
        "pos": {
          "type": "vec3",
          "desc": "Center."
        },
        "rad": {
          "type": "number",
          "desc": "Radius in meters."
        }
      },
      "returns": []
    },
    "drawPurpleLine": {
      "desc": "Draws a purple debug line (thickness 5) between two points.",
      "params": {
        "p1": {
          "type": "vec3",
          "desc": "Start."
        },
        "p2": {
          "type": "vec3",
          "desc": "End."
        }
      },
      "returns": []
    },
    "drawAutoJctMarkup": {
      "desc": "Displays at a position two debug texts: the road name and its position in the automatic junction.",
      "params": {
        "pos": {
          "type": "vec3",
          "desc": "Text position."
        },
        "rName": {
          "type": "string",
          "desc": "Road name."
        },
        "rLie": {
          "type": "string",
          "desc": "Position text (lie)."
        }
      },
      "returns": []
    },
    "isMouseHoveringOverTerrain": {
      "desc": "True if the mouse is over no ImGui element, no window and not the axes gizmo (so over the 3D view).",
      "params": {},
      "returns": [
        {
          "type": "boolean",
          "desc": "true if the mouse is over the scene."
        }
      ]
    },
    "mouseOnMapPos": {
      "desc": "World position pointed at by the mouse: static raycast from the camera, range 1000 m.",
      "params": {},
      "returns": [
        {
          "type": "vec3",
          "desc": "Point hit."
        }
      ]
    },
    "isMouseOverNode": {
      "desc": "Checks whether the mouse hovers a road node (roads whose node spheres and visibility are active, excluding locked nodes). Returns nil, nil, nil if the mouse is not over the scene or over no node.",
      "params": {
        "roads": {
          "type": "table",
          "desc": "List of roads."
        }
      },
      "returns": [
        {
          "type": "boolean|nil",
          "desc": "true if a node is hovered."
        },
        {
          "type": "integer|nil",
          "desc": "Road index."
        },
        {
          "type": "integer|nil",
          "desc": "Node index."
        }
      ]
    },
    "computeAABB2DAllRoads": {
      "desc": "2D bounding box of all nodes of all roads.",
      "params": {
        "roads": {
          "type": "table",
          "desc": "List of roads."
        }
      },
      "returns": [
        {
          "type": "table",
          "desc": "{xMin, xMax, yMin, yMax}."
        }
      ]
    },
    "computeAABB2DGroup": {
      "desc": "2D bounding box of only the nodes listed in the group. If group is nil, uses all nodes of all roads.",
      "params": {
        "group": {
          "type": "table|nil",
          "desc": "Group with list = {{r = name, n = node index}}."
        },
        "roads": {
          "type": "table",
          "desc": "List of roads."
        },
        "map": {
          "type": "table<string, integer>",
          "desc": "Table name -> road index."
        }
      },
      "returns": [
        {
          "type": "table",
          "desc": "{xMin, xMax, yMin, yMax}."
        }
      ]
    },
    "tryAddGroupIdxToRoad": {
      "desc": "Adds a placed group index to r.groupIdx if it is not already there.",
      "params": {
        "r": {
          "type": "table",
          "desc": "Road."
        },
        "placedGroupIdx": {
          "type": "integer",
          "desc": "Group index."
        }
      },
      "returns": []
    },
    "round2": {
      "desc": "Rounds to two decimals.",
      "params": {
        "num": {
          "type": "number",
          "desc": "Value."
        }
      },
      "returns": [
        {
          "type": "number",
          "desc": "Rounded value."
        }
      ]
    },
    "sqDist2D": {
      "desc": "Squared 2D distance between two points (z ignored).",
      "params": {
        "a": {
          "type": "vec3",
          "desc": "Point A."
        },
        "b": {
          "type": "vec3",
          "desc": "Point B."
        }
      },
      "returns": [
        {
          "type": "number",
          "desc": "Squared distance."
        }
      ]
    },
    "distance2D": {
      "desc": "2D distance between two points given by components.",
      "params": {
        "x1": {
          "type": "number",
          "desc": "x of point 1."
        },
        "y1": {
          "type": "number",
          "desc": "y of point 1."
        },
        "x2": {
          "type": "number",
          "desc": "x of point 2."
        },
        "y2": {
          "type": "number",
          "desc": "y of point 2."
        }
      },
      "returns": [
        {
          "type": "number",
          "desc": "Distance."
        }
      ]
    },
    "isMouseCloseToNode": {
      "desc": "Looks for nodes of other roads close (2D distance) to the selected node, for snapping/junction. The ends (first/last node) and the intermediate nodes are returned in separate lists. Ignores locked nodes and non-visible roads.",
      "params": {
        "roads": {
          "type": "table",
          "desc": "List of roads."
        },
        "selectedRoadIdx": {
          "type": "integer",
          "desc": "Road to exclude."
        },
        "selectedNodeIdx": {
          "type": "integer",
          "desc": "Reference node."
        }
      },
      "returns": [
        {
          "type": "boolean",
          "desc": "true if at least one nearby node exists."
        },
        {
          "type": "integer[]",
          "desc": "Road indices of the nearby ends."
        },
        {
          "type": "integer[]",
          "desc": "Corresponding node indices."
        },
        {
          "type": "integer[]",
          "desc": "Road indices of the nearby intermediate nodes."
        },
        {
          "type": "integer[]",
          "desc": "Corresponding node indices."
        }
      ]
    },
    "getFilenameFromPath": {
      "desc": "Extracts the file name (with extension) after the last '/'.",
      "params": {
        "path": {
          "type": "string",
          "desc": "Path."
        }
      },
      "returns": [
        {
          "type": "string|nil",
          "desc": "File name."
        }
      ]
    },
    "removeExtension": {
      "desc": "Removes the extension (dot included) from a file name; returns it as is if it has none.",
      "params": {
        "filename": {
          "type": "string",
          "desc": "File name."
        }
      },
      "returns": [
        {
          "type": "string",
          "desc": "Name without extension."
        }
      ]
    },
    "removeFileNameFromPath": {
      "desc": "Returns the folder of a path (trailing separator included), or '' if there is no separator.",
      "params": {
        "path": {
          "type": "string",
          "desc": "Path."
        }
      },
      "returns": [
        {
          "type": "string",
          "desc": "Folder path."
        }
      ]
    },
    "computeRoadLength": {
      "desc": "Computes the cumulative length from the start of the road for each division point of the renderData (following the centerline).",
      "params": {
        "rD": {
          "type": "table",
          "desc": "renderData of the road."
        }
      },
      "returns": [
        {
          "type": "number[]",
          "desc": "Cumulative lengths in meters (lengths[1] = 0)."
        }
      ]
    },
    "getHalfWidthAtNode": {
      "desc": "Half-width of the road at the first point of the renderData (assumes a constant width).",
      "params": {
        "r": {
          "type": "table",
          "desc": "Road (with renderData)."
        }
      },
      "returns": [
        {
          "type": "number",
          "desc": "Half-width in meters."
        }
      ]
    },
    "findBounds": {
      "desc": "Finds the two division point indices that bracket a given length along the road. Out of range, returns the first two or the last two indices.",
      "params": {
        "pEval": {
          "type": "number",
          "desc": "Length to locate."
        },
        "lengths": {
          "type": "number[]",
          "desc": "Cumulative lengths (computeRoadLength)."
        }
      },
      "returns": [
        {
          "type": "integer",
          "desc": "Lower index."
        },
        {
          "type": "integer",
          "desc": "Upper index."
        }
      ]
    },
    "computeDivIndicesFromNode": {
      "desc": "Finds the index of the renderData division point that corresponds to a node (2D comparison with a tolerance). Returns 1 by default.",
      "params": {
        "nIdx": {
          "type": "integer",
          "desc": "Index of the node."
        },
        "road": {
          "type": "table",
          "desc": "Road."
        }
      },
      "returns": [
        {
          "type": "integer",
          "desc": "Division index."
        }
      ]
    },
    "isInTunnel": {
      "desc": "Indicates whether a division point index is inside a tunnel (between t.s + extraS and t.e - extraE - 1).",
      "params": {
        "idx": {
          "type": "integer",
          "desc": "Division point index."
        },
        "tunnels": {
          "type": "table",
          "desc": "List of tunnels {s, e}."
        },
        "extraS": {
          "type": "integer",
          "desc": "Margin at the start."
        },
        "extraE": {
          "type": "integer",
          "desc": "Margin at the end."
        }
      },
      "returns": [
        {
          "type": "boolean",
          "desc": "true if inside a tunnel."
        }
      ]
    },
    "polyLerp": {
      "desc": "Linearly interpolates in a polyline (positions and normals) at length q. Returns nil, nil if q is outside the range of lengths.",
      "params": {
        "pos": {
          "type": "vec3[]",
          "desc": "Points of the polyline."
        },
        "nml": {
          "type": "vec3[]",
          "desc": "Normals at the points."
        },
        "lens": {
          "type": "number[]",
          "desc": "Cumulative lengths."
        },
        "q": {
          "type": "number",
          "desc": "Evaluation length."
        }
      },
      "returns": [
        {
          "type": "vec3|nil",
          "desc": "Interpolated position."
        },
        {
          "type": "vec3|nil",
          "desc": "Interpolated and normalized normal."
        }
      ]
    },
    "intersection2Lines": {
      "desc": "(2D) intersection of the infinite lines (p1,p2) and (p3,p4). Returns nil if they are parallel.",
      "params": {
        "p1": {
          "type": "vec3",
          "desc": "Point of line 1."
        },
        "p2": {
          "type": "vec3",
          "desc": "Second point of line 1."
        },
        "p3": {
          "type": "vec3",
          "desc": "Point of line 2."
        },
        "p4": {
          "type": "vec3",
          "desc": "Second point of line 2."
        }
      },
      "returns": [
        {
          "type": "vec3|nil",
          "desc": "Intersection point (z = 0)."
        }
      ]
    },
    "intersection2LineSegs": {
      "desc": "(2D) intersection of two segments [p1,p2] and [q1,q2]. Returns nil if they do not cross.",
      "params": {
        "p1": {
          "type": "vec3",
          "desc": "Start of segment 1."
        },
        "p2": {
          "type": "vec3",
          "desc": "End of segment 1."
        },
        "q1": {
          "type": "vec3",
          "desc": "Start of segment 2."
        },
        "q2": {
          "type": "vec3",
          "desc": "End of segment 2."
        }
      },
      "returns": [
        {
          "type": "vec3|nil",
          "desc": "Intersection point (z = 0). Collinear cases: division by zero possible (inferred from code)."
        }
      ]
    },
    "intersectionLineSegmentCircle": {
      "desc": "Intersection points of a 2D segment with a circle.",
      "params": {
        "x1": {
          "type": "number",
          "desc": "x start."
        },
        "y1": {
          "type": "number",
          "desc": "y start."
        },
        "x2": {
          "type": "number",
          "desc": "x end."
        },
        "y2": {
          "type": "number",
          "desc": "y end."
        },
        "cx": {
          "type": "number",
          "desc": "x of the center."
        },
        "cy": {
          "type": "number",
          "desc": "y of the center."
        },
        "r": {
          "type": "number",
          "desc": "Radius."
        }
      },
      "returns": [
        {
          "type": "table<integer, {[1]: number, [2]: number}>|nil",
          "desc": "List of points {x, y} located on the segment, or nil if there are none."
        }
      ]
    },
    "projectPointToLine": {
      "desc": "Projects a point onto the line (a,b) in 2D; the point's z is kept.",
      "params": {
        "p": {
          "type": "vec3",
          "desc": "Point."
        },
        "a": {
          "type": "vec3",
          "desc": "Point of the line."
        },
        "b": {
          "type": "vec3",
          "desc": "Second point of the line."
        }
      },
      "returns": [
        {
          "type": "vec3",
          "desc": "Projected point."
        }
      ]
    },
    "circle2DFrom3Points": {
      "desc": "Fits a 2D circle through three points; returns its center.",
      "params": {
        "p1": {
          "type": "vec3",
          "desc": "Point 1."
        },
        "p2": {
          "type": "vec3",
          "desc": "Point 2."
        },
        "p3": {
          "type": "vec3",
          "desc": "Point 3."
        }
      },
      "returns": [
        {
          "type": "vec3|nil",
          "desc": "Center of the circle, or nil (with a second nil) if the points are nearly collinear."
        }
      ]
    },
    "slerp": {
      "desc": "Spherical interpolation between two unit vectors (see notes on the formula).",
      "params": {
        "v1": {
          "type": "vec3",
          "desc": "Start vector (unit)."
        },
        "v2": {
          "type": "vec3",
          "desc": "End vector (unit)."
        },
        "t": {
          "type": "number",
          "desc": "Parameter in [0, 1]."
        }
      },
      "returns": [
        {
          "type": "vec3",
          "desc": "Interpolated vector."
        }
      ]
    },
    "angleBetweenVecs": {
      "desc": "Small angle between two vectors of arbitrary length, in radians.",
      "params": {
        "a": {
          "type": "vec3",
          "desc": "Vector A."
        },
        "b": {
          "type": "vec3",
          "desc": "Vector B."
        }
      },
      "returns": [
        {
          "type": "number",
          "desc": "Angle in [0, pi]."
        }
      ]
    },
    "angleBetweenVecs2D": {
      "desc": "Like angleBetweenVecs after projecting the vectors onto the XY plane.",
      "params": {
        "a": {
          "type": "vec3",
          "desc": "Vector A."
        },
        "b": {
          "type": "vec3",
          "desc": "Vector B."
        }
      },
      "returns": [
        {
          "type": "number",
          "desc": "Angle in radians."
        }
      ]
    },
    "clockwiseAngleBetweenVecs2D": {
      "desc": "2D angle between two vectors in the direction given by the sign of the cross product: returns the angle if cross < 0, otherwise 2*pi - angle.",
      "params": {
        "v1": {
          "type": "vec3",
          "desc": "First vector."
        },
        "v2": {
          "type": "vec3",
          "desc": "Second vector."
        }
      },
      "returns": [
        {
          "type": "number",
          "desc": "Angle in [0, 2*pi]."
        }
      ]
    },
    "rotateVecAroundAxis": {
      "desc": "Rotates v around the unit axis k by an angle theta (Rodrigues formula).",
      "params": {
        "v": {
          "type": "vec3",
          "desc": "Vector."
        },
        "k": {
          "type": "vec3",
          "desc": "Unit axis."
        },
        "theta": {
          "type": "number",
          "desc": "Angle in radians."
        }
      },
      "returns": [
        {
          "type": "vec3",
          "desc": "Rotated vector."
        }
      ]
    },
    "getRotationBetweenVecs": {
      "desc": "Quaternion that rotates v1 toward v2 (v1 and v2 are normalized in place). Special cases: nearly identical vectors -> identity; opposite -> rotation of pi around an orthogonal axis.",
      "params": {
        "v1": {
          "type": "vec3",
          "desc": "Start vector (modified)."
        },
        "v2": {
          "type": "vec3",
          "desc": "End vector (modified)."
        }
      },
      "returns": [
        {
          "type": "quat",
          "desc": "Rotation."
        }
      ]
    },
    "rotateVecByQuaternion": {
      "desc": "Rotates a vector by a quaternion (q is normalized in place).",
      "params": {
        "v": {
          "type": "vec3",
          "desc": "Vector."
        },
        "q": {
          "type": "quat",
          "desc": "Quaternion (modified)."
        }
      },
      "returns": [
        {
          "type": "vec3",
          "desc": "Rotated vector."
        }
      ]
    },
    "isPointOnLeftSideOfLine": {
      "desc": "True if the point is to the left of the directed line p1 -> p2 (2D).",
      "params": {
        "p": {
          "type": "vec3",
          "desc": "Point tested."
        },
        "p1": {
          "type": "vec3",
          "desc": "Start of the line."
        },
        "p2": {
          "type": "vec3",
          "desc": "End of the line."
        }
      },
      "returns": [
        {
          "type": "boolean",
          "desc": "true if on the left."
        }
      ]
    },
    "isInBox": {
      "desc": "True if the point is inside the 2D box {xMin, xMax, yMin, yMax} (bounds included).",
      "params": {
        "p": {
          "type": "vec3",
          "desc": "Point."
        },
        "box": {
          "type": "table",
          "desc": "Box."
        }
      },
      "returns": [
        {
          "type": "boolean",
          "desc": "true if inside."
        }
      ]
    },
    "isOverTerrain": {
      "desc": "True if the point is directly above the terrain (and not a bridge): compares the terrain height with that of a ray cast downward from 4.5 m above (tolerance 0.25 m).",
      "params": {
        "p": {
          "type": "vec3",
          "desc": "Point."
        }
      },
      "returns": [
        {
          "type": "boolean",
          "desc": "true if on the terrain."
        }
      ]
    },
    "randomInRange": {
      "desc": "Random integer in [a, b] (bounds included; a and b are swapped if a > b).",
      "params": {
        "a": {
          "type": "integer",
          "desc": "Bound."
        },
        "b": {
          "type": "integer",
          "desc": "Bound."
        }
      },
      "returns": [
        {
          "type": "integer",
          "desc": "Draw."
        }
      ]
    }
  }
}
