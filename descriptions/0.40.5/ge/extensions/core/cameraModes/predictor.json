{
  "path": "lua/ge/extensions/core/cameraModes/predictor.lua",
  "module": "Filter that anticipates the vehicle's movement: shifts data.res.targetPos by dtFuture * data.vel (vehicle velocity) then recomputes the rotation toward that target. Hidden. Returns a constructor.",
  "classes": {
    "C": {
      "desc": "Target prediction filter.",
      "functions": {
        "init": {
          "desc": "Sets isFilter, hidden and dtFuture.",
          "params": {
            "dtFuture": {
              "type": "number|nil",
              "desc": "look-ahead in seconds (0.1 by default)"
            }
          }
        },
        "update": {
          "desc": "Advances targetPos and updates data.res.rot.",
          "params": {
            "data": {
              "type": "table",
              "desc": "camData"
            }
          },
          "returns": [
            {
              "type": "boolean",
              "desc": "always true"
            }
          ],
          "internal": true
        }
      }
    }
  }
}
