      "desc": "No-op marker, instance returned by the module's constructor.",
      "functions": {
        "init": {
          "desc": "Does nothing.",
          "internal": true
        },
        "update": {
          "desc": "Does nothing (called every frame by the marker manager).",
          "params": {
