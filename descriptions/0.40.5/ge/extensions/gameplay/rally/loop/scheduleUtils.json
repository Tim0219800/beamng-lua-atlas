{
  "path": "lua/ge/extensions/gameplay/rally/loop/scheduleUtils.lua",
  "module": "Small utility functions for schedule computation for rally loops: rounding up to the next minute, conversion of slot sizes from minutes to seconds, next slot computation, time comparison with tolerance. All times are in seconds.",
  "functions": {
    "roundToNextMinute": {
      "desc": "Rounds a time up to the next minute: ceil(t / 60) * 60.",
      "params": {
        "timeSecs": {
          "type": "number",
          "desc": "Time in seconds."
        }
      },
      "returns": [
        {
          "type": "number",
          "desc": "Rounded time, in seconds."
        }
      ]
    },
    "slotMinutesToSeconds": {
      "desc": "Converts a slot size from minutes to seconds (1 minute by default if nil).",
      "params": {
        "slotSizeMinutes": {
          "type": "number|nil",
          "desc": "Slot size in minutes."
        }
      },
      "returns": [
        {
          "type": "number",
          "desc": "Seconds."
        }
      ]
    },
    "calculateNextSlotTime": {
      "desc": "Adds the slot duration to the current time then, by default, rounds up to the next minute.",
      "params": {
        "currentTime": {
          "type": "number",
          "desc": "Current time in seconds."
        },
        "slotSizeMinutes": {
          "type": "number|nil",
          "desc": "Slot size in minutes (default 1)."
        },
        "roundToMinute": {
          "type": "boolean|nil",
          "desc": "true by default; false to not round."
        }
      },
      "returns": [
        {
          "type": "number",
          "desc": "Next slot in seconds."
        }
      ]
    },
    "isLaterTime": {
      "desc": "Tests whether newTime is strictly greater than currentTime + tolerance.",
      "params": {
        "newTime": {
          "type": "number",
          "desc": "Time to test."
        },
        "currentTime": {
          "type": "number",
          "desc": "Reference time."
        },
        "tolerance": {
          "type": "number|nil",
          "desc": "Tolerance in seconds (default 0)."
        }
      },
      "returns": [
        {
          "type": "boolean",
          "desc": "true if newTime > currentTime + tolerance."
        }
      ]
    }
  }
}
