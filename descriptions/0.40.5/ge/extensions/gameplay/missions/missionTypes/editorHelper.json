            }
          },
          "returns": [
            {
              "type": "table",
              "desc": "Element."
            }
          ]
        },
        "addReward": {
          "desc": "Numeric field of type \"reward\".",
          "params": {
            "label": {
              "type": "string",
              "desc": "Label."
            },
            "fieldName": {
              "type": "string",
              "desc": "Key in missionTypeData."
            },
            "defaultValue": {
              "type": "number|nil",
              "desc": "Default value."
            }
          },
          "returns": [
