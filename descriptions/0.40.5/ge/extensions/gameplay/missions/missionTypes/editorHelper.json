        "clear": {
          "desc": "Empties the list of elements.",
          "params": {},
          "returns": []
        },
        "getNewData": {
          "desc": "Builds the default missionTypeData table of a new mission by gathering the default values of all elements.",
          "params": {},
          "returns": [
            {
              "type": "table<string, any>",
              "desc": "Field -> default value."
            }
          ]
        },
        "setMission": {
          "desc": "Loads a mission into the editor: stores self.mission and updates each widget from mission.missionTypeData, then calls valueChangedCallback.",
          "params": {
            "m": {
              "type": "table",
              "desc": "Mission (with missionTypeData)."
            }
          },
          "returns": []
        },
        "checkMission": {
          "desc": "Checks missionTypeData against the elements: missing fields, different types, extra fields, nonexistent models/configs/files. Returns the list of problems {label, severity, fixable, data}.",
          "params": {
            "m": {
              "type": "table",
              "desc": "Mission."
            },
            "fix": {
              "type": "boolean|nil",
              "desc": "Parameter declared but unused in the part read (inferred from code)."
            }
          },
          "returns": [
            {
              "type": "table[]",
              "desc": "List of problems."
            }
          ]
        },
        "updateMouseInfo": {
          "desc": "Updates mouseInfo: camera position, ray and ray hit under the mouse (forest collision disabled during the cast), click/hold/release state, hovered element.",
          "params": {
            "mission": {
              "type": "table",
              "desc": "Mission being edited."
            }
          },
          "returns": [],
