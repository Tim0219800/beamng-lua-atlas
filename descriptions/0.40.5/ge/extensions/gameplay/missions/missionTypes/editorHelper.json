        "addSimpleLapConfig": {
          "desc": "Simple lap configuration (editor/util/lapConfigUtil tool).",
          "params": {
            "label": {
              "type": "string",
              "desc": "Label."
            },
            "fieldName": {
              "type": "string",
              "desc": "Key in missionTypeData."
            },
            "displayOptions": {
