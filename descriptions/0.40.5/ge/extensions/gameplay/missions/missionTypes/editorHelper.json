          "returns": [
            {
              "type": "table",
              "desc": "Element."
            }
          ]
        },
        "addMissionId": {
          "desc": "Field containing the id of another mission; default \"(none)\".",
          "params": {
            "label": {
              "type": "string",
              "desc": "Label."
            },
            "fieldName": {
              "type": "string",
              "desc": "Key in missionTypeData."
            },
            "defaultValue": {
              "type": "string|nil",
              "desc": "Default value."
            },
            "displayOptions": {
              "type": "table|nil",
              "desc": "Display options."
            }
          },
          "returns": [
            {
              "type": "table",
              "desc": "Element."
            }
          ]
        },
        "addDecoHeader": {
