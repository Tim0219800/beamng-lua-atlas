{
  "path": "lua/ge/extensions/ui/apps/minimap/layers.lua",
  "module": "Numeric constants for the minimap's drawing layers. Layers are rendered from the lowest (0) to the highest: background, grid, roads, route, gameplay markers, vehicles, round/square mask, compass, pointers, debug. This is not a loadable extension: the minimap modules read it with require(\"ui/apps/minimap/layers\").",
  "fields": {
    "BACKGROUND": {
      "type": "integer",
      "desc": "0: background (very bottom)."
    },
    "BG_GRID": {
      "type": "integer",
      "desc": "10: background grid."
    },
    "ROADS_BG": {
      "type": "integer",
      "desc": "20: road outline."
    },
    "ROADS_FG": {
      "type": "integer",
      "desc": "30: road stroke."
    },
    "ROUTE_BG": {
      "type": "integer",
      "desc": "40: route outline."
    },
    "ROUTE_FG": {
      "type": "integer",
      "desc": "50: route stroke."
    },
    "GAMEPLAY_MARKERS": {
      "type": "integer",
      "desc": "60: gameplay markers."
    },
    "VEHICLES_OTHER": {
      "type": "integer",
      "desc": "70: other vehicles."
    },
    "VEHICLES_POLICE": {
      "type": "integer",
      "desc": "80: police vehicles."
    },
    "VEHICLES_USABLE": {
      "type": "integer",
      "desc": "90: usable vehicles."
    },
    "VEHICLE_PLAYER": {
      "type": "integer",
      "desc": "100: player vehicle."
    },
    "ROUND_OR_SQUARE_MASK": {
      "type": "integer",
      "desc": "110: occlusion mask (round or square frame)."
    },
    "COMPASS": {
      "type": "integer",
      "desc": "120: compass."
    },
    "ROUTE_POINTER": {
      "type": "integer",
      "desc": "130: pointer to the destination."
    },
    "GAMEPLAY_POINTER": {
      "type": "integer",
      "desc": "140: gameplay pointer."
    },
    "DEBUG": {
      "type": "integer",
      "desc": "150: debug layer (very top)."
    }
  }
}
