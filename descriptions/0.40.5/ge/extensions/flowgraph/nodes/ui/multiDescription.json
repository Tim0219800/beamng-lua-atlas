{
  "path": "lua/ge/extensions/flowgraph/nodes/ui/multiDescription.lua",
  "module": "Flowgraph node \"Multi Description\" (category repeat_instant): merges several texts into a multiple description for Start Screen / End Screen. Inputs \"value_i\" (any); output \"value\" (table of type multiTranslationObject: list of values).",
  "notes": [
    "drawMiddle uses self.data.pattern, inherited from another node (nil in practice)."
  ],
  "fields": {},
  "functions": {},
  "classes": {
    "C": {
      "desc": "Flowgraph node class (returned by _flowgraph_createNode(C)).",
      "functions": {
        "_onDeserialized": {
          "desc": "Restores count.",
          "params": {
            "res": {
              "type": "table",
              "desc": "Node save table to fill."
            }
          },
          "internal": true
        },
        "_onSerialize": {
          "desc": "Saves count.",
          "params": {
            "res": {
              "type": "table",
              "desc": "Node save table to fill."
            }
          },
          "internal": true
        },
        "drawCustomProperties": {
          "desc": "\"Count\" field.",
          "internal": true
        },
        "drawMiddle": {
          "desc": "Displays self.data.pattern (first 10 characters) if defined.",
          "params": {
            "builder": {
              "type": "any",
              "desc": "Editor node builder (builder:Middle() opens the central area)."
            },
            "style": {
              "type": "any",
              "desc": "Node display style provided by the editor."
            }
          },
          "internal": true
        },
        "init": {
          "desc": "count = 1.",
          "internal": true
        },
        "postInit": {
          "desc": "Creates the initial pins.",
          "internal": true
        },
        "updatePins": {
          "desc": "Adjusts the number of value_i pins.",
          "params": {
            "old": {
              "type": "integer",
              "desc": "Old number of elements."
            },
            "new": {
              "type": "integer",
              "desc": "New number of elements."
            }
          },
          "internal": true
        },
        "work": {
          "desc": "Builds the list of input values and writes it to \"value\".",
          "internal": true
        }
      }
    }
  }
}
