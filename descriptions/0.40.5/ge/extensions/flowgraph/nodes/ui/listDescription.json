{
  "path": "lua/ge/extensions/flowgraph/nodes/ui/listDescription.lua",
  "module": "Flowgraph node \"List Description\" (category repeat_instant): builds a list text from translation keys or contextual translation objects. Inputs \"item_i\" (string or table) for each element; output \"value\" (string). Empty elements are ignored; formatting is done by self.mgr.modules.ui:buildListText.",
  "fields": {},
  "functions": {},
  "classes": {
    "C": {
      "desc": "Flowgraph node class (returned by _flowgraph_createNode(C)).",
      "functions": {
        "_onDeserialized": {
          "desc": "Restores count.",
          "params": {
            "res": {
              "type": "table",
              "desc": "Node save table to fill."
            }
          },
          "internal": true
        },
        "_onSerialize": {
          "desc": "Saves count.",
          "params": {
            "res": {
              "type": "table",
              "desc": "Node save table to fill."
            }
          },
          "internal": true
        },
        "drawCustomProperties": {
          "desc": "\"List Item Count\" field.",
          "internal": true
        },
        "init": {
          "desc": "count = 1.",
          "internal": true
        },
        "postInit": {
          "desc": "Creates the initial pins.",
          "internal": true
        },
        "updatePins": {
          "desc": "Adjusts the number of item_i pins.",
          "params": {
            "old": {
              "type": "integer",
              "desc": "Old number of elements."
            },
            "new": {
              "type": "integer",
              "desc": "New number of elements."
            }
          },
          "internal": true
        },
        "work": {
          "desc": "Translates each element (core_locales.translateWithOrWithoutContext), builds the list and writes it to \"value\".",
          "internal": true
        }
      }
    }
  }
}
