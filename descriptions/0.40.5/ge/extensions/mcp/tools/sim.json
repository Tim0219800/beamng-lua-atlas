{
  "path": "lua/ge/extensions/mcp/tools/sim.lua",
  "module": "MCP simulation control tools: read the state, change the time scale, pause the physics, resume it, or advance it step by step. Relies on the engine object `be`.",
  "notes": [
    "Pause only freezes the physics: rendering and the camera continue.",
    "step_physics always leaves the physics paused after the requested ticks."
  ],
  "fields": {
    "schemas": {
      "type": "table<string, table>",
      "desc": "Schemas of the simulation tools."
    }
  },
  "functions": {
    "get_simulation_state": {
      "desc": "Simulation state as JSON: physicsRunning, timeScale, speedFactor, deterministic, enabled (be:getPhysicsRunning, getSimulationTimeScale, getPhysicsSpeedFactor, getPhysicsDeterministic, getEnabled).",
      "params": {},
      "returns": [
        {
          "type": "string",
          "desc": "JSON."
        },
        {
          "type": "boolean",
          "desc": "false."
        }
      ],
      "internal": false
    },
    "set_simulation_speed": {
      "desc": "Sets the simulation time scale (be:setSimulationTimeScale).",
      "params": {
        "args": {
          "type": "table",
          "desc": "{scale: number} 1 = normal, <1 slow motion, >1 sped up."
        }
      },
      "returns": [
        {
          "type": "string",
          "desc": "Confirmation."
        },
        {
          "type": "boolean",
          "desc": "true if scale is missing."
        }
      ],
      "internal": false
    },
    "pause_physics": {
      "desc": "Pauses the physics (be:setPhysicsRunning(false)).",
      "params": {},
      "returns": [
        {
          "type": "string",
          "desc": "Message."
        },
        {
          "type": "boolean",
          "desc": "false."
        }
      ],
      "internal": false
    },
    "resume_physics": {
      "desc": "Resumes the physics (be:setPhysicsRunning(true)).",
      "params": {},
      "returns": [
        {
          "type": "string",
          "desc": "Message."
        },
        {
          "type": "boolean",
          "desc": "false."
        }
      ],
      "internal": false
    },
    "step_physics": {
      "desc": "Pauses the physics then advances N ticks (be:physicsStep); it stays paused.",
      "params": {
        "args": {
          "type": "table|nil",
          "desc": "{steps?: integer} number of physics ticks (default 1, minimum 1)."
        }
      },
      "returns": [
        {
          "type": "string",
          "desc": "Message."
        },
        {
          "type": "boolean",
          "desc": "false."
        }
      ],
      "internal": false
    }
  }
}
