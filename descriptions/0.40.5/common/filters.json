    "freqDetector": {
      "desc": "Estimates the period, amplitude and DC bias of an oscillating signal by tracking peaks and troughs.",
      "functions": {
        "get": {
          "desc": "Updates with a sample. Returns period, peak amplitude, time since the previous peak (prevPeakDt) and DC bias. The approximated signal is cos(peakDt*2*pi/(period+1e-30))*ampl + bias.",
          "params": {
            "sample": {
              "type": "number",
              "desc": "sample"
            },
            "dt": {
              "type": "number",
              "desc": "time step (s)"
            }
          },
          "returns": [
            {
              "type": "number",
              "desc": "period (s)"
            },
            {
              "type": "number",
              "desc": "peak amplitude"
            },
            {
              "type": "number",
              "desc": "prevPeakDt"
            },
            {
              "type": "number",
              "desc": "DC bias"
            }
          ]
        },
        "reset": {
          "desc": "Resets peaks, troughs, period, amplitude and bias to zero.",
          "params": {},
          "returns": []
        },
        "value": {
          "desc": "Returns the latest estimate (period, amplitude, prevPeakDt, bias) while advancing the timers by dt (0 by default).",
          "params": {
            "dt": {
              "type": "number|nil",
              "desc": "time elapsed since the last get, default 0"
            }
          },
          "returns": [
            {
              "type": "number",
              "desc": "period"
            },
            {
              "type": "number",
              "desc": "amplitude"
            },
            {
              "type": "number",
              "desc": "prevPeakDt"
            },
            {
              "type": "number",
              "desc": "bias"
            }
          ]
        }
      }
    },
    "freqExists": {
      "desc": "Measures the amplitude of a specific frequency in a signal (Goertzel algorithm).",
      "functions": {
        "get": {
          "desc": "Cycle mode: accumulates samples and, every cycleCount cycles of freq, updates and returns the amplitude (otherwise returns the last amplitude). More cycles = more accurate but more latency.",
          "params": {
            "sample": {
              "type": "number",
              "desc": "sample"
            },
            "dt": {
              "type": "number",
              "desc": "time step (s)"
            },
            "freq": {
              "type": "number",
              "desc": "target frequency (Hz)"
            },
            "cycleCount": {
              "type": "number|nil",
              "desc": "number of cycles per measurement, default 1"
            }
          },
          "returns": [
            {
              "type": "number",
              "desc": "amplitude of freq"
            }
          ]
        },
        "getS": {
          "desc": "Per-sample sliding mode: returns the amplitude on each call; returns 0 if freq*dt >= 0.5 (beyond Nyquist). Larger winCoef = more accurate but slower.",
          "params": {
            "sample": {
              "type": "number",
              "desc": "sample"
            },
            "dt": {
              "type": "number",
              "desc": "time step (s)"
            },
            "freq": {
              "type": "number",
              "desc": "target frequency (Hz)"
            },
            "winCoef": {
              "type": "number|nil",
              "desc": "window coefficient, default 10"
            }
          },
          "returns": [
            {
              "type": "number",
              "desc": "amplitude"
            }
          ]
        },
        "bufferStart": {
          "desc": "Starts batch processing (buffer) for frequency freq at step dt. Follow with bufferAdd for each sample then bufferEnd.",
          "params": {
            "dt": {
              "type": "number",
              "desc": "time step (s)"
            },
            "freq": {
              "type": "number",
              "desc": "target frequency (Hz)"
            }
          },
          "returns": []
        },
        "bufferAdd": {
          "desc": "Adds a sample to the current batch.",
          "params": {
            "sample": {
              "type": "number",
              "desc": "sample"
            }
          },
          "returns": []
        },
        "bufferEnd": {
          "desc": "Ends the batch and returns the amplitude of the frequency.",
          "params": {},
          "returns": [
            {
              "type": "number",
              "desc": "amplitude"
            }
          ]
        },
        "reset": {
          "desc": "Resets the state to zero.",
          "params": {},
          "returns": []
        }
      }
    },
