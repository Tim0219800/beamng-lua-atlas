          ]
        },
        "getWithRateAccel": {
          "desc": "Like get with the given max speed and accelerations (stopAccel default startAccel).",
          "params": {
            "sample": {
              "type": "number",
              "desc": "setpoint"
            },
            "dt": {
              "type": "number",
              "desc": "time step (s)"
            },
            "ratelimit": {
              "type": "number",
              "desc": "max speed"
