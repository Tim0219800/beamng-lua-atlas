    "temporalSigmoidSmoothing": {
      "desc": "S-curve smoothing with speed (rate) and acceleration limiting.",
      "functions": {
        "get": {
          "desc": "Advances one step toward sample. The max speed is that of the constructor (inRate / outRate depending on whether the value moves away from 0).",
          "params": {
