{
  "path": "lua/common/testFramework/MockGenerators.lua",
  "module": "Mock data generators for extension tests (used by testFramework/ExtensionTest). Each `generateMockData_<hook>` function triggers the corresponding hook via `extensions.hook(hook, ...)` with plausible arguments, to check that an extension defining this hook does not crash. `generateMockData_default(hookName)` is used for hooks without a dedicated generator (call without arguments). To add a covered hook, simply add `M.generateMockData_<hookName>`.",
  "notes": [
    "The generators call extensions.hook themselves; their return value is not used by ExtensionTest (which also accepts a list of calls {args = {...}} but no generator returns one).",
    "The mock vehicles (mockVehicle) only have getID() and queueLuaCommand() (no effect).",
    "ExtensionTest reports as \"missing\" the `on*` hooks of an extension that have no exact generator (the default generator does not count as coverage)."
  ],
  "functions": {
    "generateMockData_default": {
      "desc": "Triggers the hook `hookName` without arguments.",
      "params": {
        "hookName": {
          "type": "string",
          "desc": "Hook name."
        }
      },
      "returns": []
    },
    "generateMockData_onUpdate": {
      "desc": "extensions.hook('onUpdate', 0.016, 0.016, 0.016).",
      "params": {},
      "returns": []
    },
    "generateMockData_updateGFX": {
      "desc": "extensions.hook('updateGFX', 0.016).",
      "params": {},
      "returns": []
    },
    "generateMockData_onPhysicsStep": {
      "desc": "extensions.hook('onPhysicsStep', 0.001).",
      "params": {},
      "returns": []
    },
    "generateMockData_onSerialize": {
      "desc": "extensions.hook('onSerialize', 'extensionTest').",
      "params": {},
      "returns": []
    },
    "generateMockData_onDeserialize": {
      "desc": "extensions.hook('onDeserialize', {}).",
      "params": {},
      "returns": []
    },
    "generateMockData_onDeserialized": {
      "desc": "extensions.hook('onDeserialized', {}).",
      "params": {},
      "returns": []
    },
    "generateMockData_onExtensionLoaded": {
