      "functions": {
        "preLoad": {
          "desc": "Adds an element (before build).",
          "params": {
            "id": {
              "type": "any",
              "desc": "id returned by the queries"
            },
            "xmin": {
              "type": "number",
              "desc": "xmin"
            },
            "ymin": {
              "type": "number",
              "desc": "ymin"
            },
            "zmin": {
              "type": "number",
              "desc": "zmin"
            },
            "xmax": {
              "type": "number",
              "desc": "xmax"
            },
            "ymax": {
              "type": "number",
              "desc": "ymax"
            },
            "zmax": {
              "type": "number",
              "desc": "zmax"
            }
          },
          "returns": []
        },
        "build": {
          "desc": "Builds the tree (recursive median alternating the axes) from the loaded elements.",
          "params": {},
          "returns": []
        },
        "_build": {
          "desc": "Internal: recursive construction of a node.",
          "params": {
            "axis": {
              "type": "integer",
              "desc": "current axis"
            },
            "left": {
              "type": "integer",
              "desc": "start index in items"
            },
            "right": {
              "type": "integer",
              "desc": "end index"
            },
            "treeIdx": {
              "type": "integer",
              "desc": "node index"
            }
          },
          "returns": [],
          "internal": true
        },
        "query": {
          "desc": "Iterator over the ids of the elements whose box intersects the query box; nesting possible.",
          "params": {
            "query_xmin": {
              "type": "number",
              "desc": "xmin"
            },
            "query_ymin": {
              "type": "number",
              "desc": "ymin"
            },
            "query_zmin": {
              "type": "number",
              "desc": "zmin"
            },
            "query_xmax": {
              "type": "number",
              "desc": "xmax"
            },
            "query_ymax": {
              "type": "number",
              "desc": "ymax"
            },
            "query_zmax": {
              "type": "number",
              "desc": "zmax"
            }
          },
          "returns": [
            {
              "type": "function",
              "desc": "iterator returning the ids"
            },
            {
              "type": "table",
              "desc": "iteration state"
            }
          ]
        },
        "queryNotNested": {
          "desc": "Like query without allocation; nesting forbidden.",
          "params": {
            "query_xmin": {
              "type": "number",
              "desc": "xmin"
            },
            "query_ymin": {
              "type": "number",
              "desc": "ymin"
            },
            "query_zmin": {
              "type": "number",
              "desc": "zmin"
            },
            "query_xmax": {
              "type": "number",
              "desc": "xmax"
            },
            "query_ymax": {
              "type": "number",
              "desc": "ymax"
            },
            "query_zmax": {
              "type": "number",
              "desc": "zmax"
            }
          },
          "returns": [
            {
