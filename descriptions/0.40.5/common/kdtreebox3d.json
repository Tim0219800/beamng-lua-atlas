        },
        "export": {
          "desc": "Returns the tree data (references) for serialization/reuse.",
          "params": {},
          "returns": [
            {
              "type": "table",
              "desc": "exported data"
            }
          ]
        },
        "import": {
          "desc": "Loads data produced by export().",
          "params": {
            "kdTreeData": {
              "type": "table",
              "desc": "export table"
            }
          },
          "returns": []
        },
        "analytics": {
          "desc": "Prints (print) tree statistics.",
