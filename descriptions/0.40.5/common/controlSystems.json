{
  "path": "lua/common/controlSystems.lua",
  "module": "Provides two PID controllers: parallel form (newPIDParallel, gains kP/kI/kD) and standard form (newPIDStandard, kP with integral time tI and derivative time tD). Both differentiate on the process variable (not on the error) to avoid spikes when the setpoint changes, and handle output saturation, integral anti-windup and an error deadzone. A modder uses them to regulate a torque, an RPM, a speed, etc.",
  "usage": "local pid = newPIDParallel(1, 0.5, 0.1, 0, 1)\n-- at each time step:\nlocal output, err = pid:get(currentValue, targetValue, dt)",
  "notes": [
    "The constructors are global functions; the returned objects have a get method (assigned in the data table) that points to getMethod, or getWithDebugMethod if setDebug(true).",
    "get returns two values: the PID output and the current error (useful to detect a near-steady state).",
    "dt must be > 0 (division by dt in the derivative term).",
    "If |error| < errorDeadzone, the error is set to 0 AND the integral is reset to 0.",
    "integralInCoef applies when the integral and the error have opposite signs or are zero (the integral decreases), integralOutCoef when they have the same sign (the integral grows).",
    "Probable bug: PIDParallel:setConfig computes maxIntegral with the kI parameter (not self.kI): calling setConfig without kI or maxIntegral causes an arithmetic error on nil.",
    "Inconsistency: PIDStandard:reset resets neither error nor output (unlike PIDParallel:reset).",
    "The debug methods use guihooks.graph to plot error, integral and output."
  ],
  "fields": {},
  "functions": {
    "newPIDParallel": {
      "desc": "Creates a parallel-form PID: output = kP*error + kI*integral + kD*(−dPV/dt).",
      "params": {
        "kP": {
          "type": "number",
          "desc": "Proportional gain."
        },
        "kI": {
          "type": "number",
          "desc": "Integral gain."
        },
        "kD": {
          "type": "number",
          "desc": "Derivative gain (applied to the change of the process variable)."
        },
        "minOutput": {
          "type": "number|nil",
          "desc": "Minimum output (default -math.huge)."
        },
        "maxOutput": {
          "type": "number|nil",
          "desc": "Maximum output (default math.huge)."
        },
        "integralInCoef": {
          "type": "number|nil",
          "desc": "Integral accumulation coefficient when it moves away from zero (default 1)."
        },
        "integralOutCoef": {
          "type": "number|nil",
          "desc": "Coefficient applied when the integral shrinks (default 1)."
        },
        "minIntegral": {
          "type": "number|nil",
          "desc": "Lower bound of the integral (default -maxIntegral)."
        },
        "maxIntegral": {
          "type": "number|nil",
          "desc": "Upper bound of the integral (default maxOutput / kI)."
        },
        "errorDeadzone": {
          "type": "number|nil",
          "desc": "Deadzone on |error| (default 0)."
        }
      },
      "returns": [
        {
          "type": "table",
          "desc": "PIDParallel object (methods get, setConfig, reset, setDebug, dump, drawDebug)."
        }
      ],
      "internal": false
    },
    "newPIDStandard": {
      "desc": "Creates a standard-form PID: output = kP*(error + integral/tI + tD*(−dPV/dt)).",
      "params": {
        "kP": {
          "type": "number",
          "desc": "Overall proportional gain."
        },
        "tI": {
          "type": "number",
          "desc": "Integral time; if <= 0, the integral term is disabled (coefficient 0)."
        },
        "tD": {
          "type": "number",
          "desc": "Derivative time."
        },
        "minOutput": {
          "type": "number|nil",
          "desc": "Minimum output (default -math.huge)."
        },
        "maxOutput": {
          "type": "number|nil",
          "desc": "Maximum output (default math.huge)."
        },
        "integralInCoef": {
          "type": "number|nil",
          "desc": "Integral accumulation coefficient (default 1)."
        },
        "integralOutCoef": {
          "type": "number|nil",
          "desc": "Integral shrink coefficient (default 1)."
        },
        "minIntegral": {
          "type": "number|nil",
          "desc": "Lower bound of the integral (default -maxIntegral)."
        },
        "maxIntegral": {
          "type": "number|nil",
          "desc": "Upper bound of the integral (default maxOutput)."
        },
        "errorDeadzone": {
          "type": "number|nil",
          "desc": "Deadzone on |error| (default 0)."
        }
      },
      "returns": [
        {
          "type": "table",
          "desc": "PIDStandard object (same methods as PIDParallel)."
        }
      ],
      "internal": false
    }
  },
  "classes": {
    "PIDParallel": {
      "desc": "Object returned by newPIDParallel. Public fields: kP, kI, kD, error, integral, output, minOutput, maxOutput, minIntegral, maxIntegral, errorDeadzone, integralInCoef, integralOutCoef, lastProcessVariable, debugEnabled, get.",
      "functions": {
        "get": {
          "desc": "Field alias to getMethod (or getWithDebugMethod in debug mode). Usage: pid:get(processVariable, setPoint, dt).",
          "params": {
            "processVariable": {
              "type": "number",
              "desc": "Current measurement."
            },
            "setPoint": {
              "type": "number",
              "desc": "Setpoint."
            },
            "dt": {
              "type": "number",
              "desc": "Time step in seconds."
            }
          },
          "returns": [
            {
              "type": "number",
              "desc": "Bounded PID output."
            },
            {
              "type": "number",
              "desc": "Error (setpoint - measurement) after the deadzone."
            }
          ]
        },
        "getMethod": {
          "desc": "Computes the PID output for this time step and updates error, integral, output, lastProcessVariable.",
          "params": {
            "processVariable": {
              "type": "number",
              "desc": "Current measurement."
            },
            "setPoint": {
              "type": "number",
              "desc": "Setpoint."
            },
            "dt": {
              "type": "number",
              "desc": "Time step in seconds (> 0)."
            }
          },
          "returns": [
            {
              "type": "number",
              "desc": "Bounded output."
            },
            {
              "type": "number",
              "desc": "Error."
            }
          ]
        },
        "getWithDebugMethod": {
          "desc": "Like getMethod but also calls drawDebug. Returns only the output (not the error).",
          "params": {
            "processVariable": {
              "type": "number",
              "desc": "Current measurement."
            },
            "setPoint": {
              "type": "number",
              "desc": "Setpoint."
            },
            "dt": {
              "type": "number",
              "desc": "Time step in seconds."
            }
          },
          "returns": [
            {
              "type": "number",
              "desc": "Bounded output."
            }
          ]
        },
        "setConfig": {
          "desc": "Changes the parameters; each nil argument keeps the current value.",
          "params": {
            "kP": {
              "type": "number|nil",
              "desc": "Proportional gain."
            },
            "kI": {
              "type": "number|nil",
              "desc": "Integral gain."
            },
            "kD": {
              "type": "number|nil",
              "desc": "Derivative gain."
            },
            "minOutput": {
              "type": "number|nil",
              "desc": "Min output."
            },
            "maxOutput": {
              "type": "number|nil",
              "desc": "Max output."
            },
            "integralInCoef": {
              "type": "number|nil",
              "desc": "Accumulation coefficient."
            },
            "integralOutCoef": {
              "type": "number|nil",
              "desc": "Shrink coefficient."
            },
            "minIntegral": {
              "type": "number|nil",
              "desc": "Lower bound of the integral."
            },
            "maxIntegral": {
              "type": "number|nil",
              "desc": "Upper bound of the integral."
            },
            "errorDeadzone": {
              "type": "number|nil",
              "desc": "Deadzone."
            }
          }
        },
        "reset": {
          "desc": "Resets error, output, integral and lastProcessVariable to 0.",
          "params": {}
        },
        "drawDebug": {
          "desc": "Sends error, integral and output to the debug graph via guihooks.graph.",
          "params": {}
        },
        "setDebug": {
          "desc": "Enables/disables debug plotting by changing the get method.",
          "params": {
            "debugEnabled": {
              "type": "boolean",
              "desc": "true to use getWithDebugMethod."
            }
          }
        },
        "dump": {
          "desc": "Prints the PID configuration with print.",
          "params": {}
        }
      }
    },
    "PIDStandard": {
      "desc": "Object returned by newPIDStandard. Public fields: kP, tICoef (1/tI), tD, error, integral, output, minOutput, maxOutput, minIntegral, maxIntegral, errorDeadzone, integralInCoef, integralOutCoef, lastProcessVariable, debugEnabled, get.",
      "functions": {
        "get": {
          "desc": "Field alias to getMethod (or getWithDebugMethod in debug mode). Usage: pid:get(processVariable, setPoint, dt).",
          "params": {
            "processVariable": {
              "type": "number",
              "desc": "Current measurement."
            },
            "setPoint": {
              "type": "number",
              "desc": "Setpoint."
            },
            "dt": {
              "type": "number",
              "desc": "Time step in seconds."
            }
          },
          "returns": [
            {
              "type": "number",
              "desc": "Bounded PID output."
            },
            {
              "type": "number",
              "desc": "Error."
            }
          ]
        },
        "getMethod": {
          "desc": "Computes the standard PID output for this time step.",
          "params": {
            "processVariable": {
              "type": "number",
              "desc": "Current measurement."
            },
            "setPoint": {
              "type": "number",
              "desc": "Setpoint."
            },
            "dt": {
              "type": "number",
              "desc": "Time step in seconds (> 0)."
            }
          },
          "returns": [
            {
              "type": "number",
              "desc": "Bounded output."
            },
            {
              "type": "number",
              "desc": "Error."
            }
          ]
        },
        "getWithDebugMethod": {
          "desc": "Like getMethod but calls drawDebug; returns only the output.",
          "params": {
            "processVariable": {
              "type": "number",
              "desc": "Current measurement."
            },
            "setPoint": {
              "type": "number",
              "desc": "Setpoint."
            },
            "dt": {
              "type": "number",
              "desc": "Time step in seconds."
            }
          },
          "returns": [
            {
              "type": "number",
              "desc": "Bounded output."
            }
          ]
        },
        "setConfig": {
          "desc": "Changes the parameters; nil keeps the value. tI is only taken into account if it is > 0.",
          "params": {
            "kP": {
              "type": "number|nil",
              "desc": "Proportional gain."
            },
            "tI": {
              "type": "number|nil",
              "desc": "Integral time."
            },
            "tD": {
              "type": "number|nil",
              "desc": "Derivative time."
            },
            "minOutput": {
              "type": "number|nil",
              "desc": "Min output."
            },
            "maxOutput": {
              "type": "number|nil",
              "desc": "Max output."
            },
            "integralInCoef": {
              "type": "number|nil",
              "desc": "Accumulation coefficient."
            },
            "integralOutCoef": {
              "type": "number|nil",
              "desc": "Shrink coefficient."
            },
            "minIntegral": {
              "type": "number|nil",
              "desc": "Lower bound of the integral."
            },
            "maxIntegral": {
              "type": "number|nil",
              "desc": "Upper bound of the integral."
            },
            "errorDeadzone": {
              "type": "number|nil",
              "desc": "Deadzone."
            }
          }
        },
        "reset": {
          "desc": "Resets integral and lastProcessVariable to 0 (error and output are untouched).",
          "params": {}
        },
        "drawDebug": {
          "desc": "Sends error, integral and output to the debug graph via guihooks.graph.",
          "params": {}
        },
        "setDebug": {
          "desc": "Enables/disables debug plotting by changing the get method.",
          "params": {
            "debugEnabled": {
              "type": "boolean",
              "desc": "true to use getWithDebugMethod."
            }
          }
        },
        "dump": {
          "desc": "Prints the PID configuration with print.",
          "params": {}
        }
      }
    }
  }
}
