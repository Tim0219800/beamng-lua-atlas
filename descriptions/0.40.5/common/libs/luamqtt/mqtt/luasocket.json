{
  "path": "lua/common/libs/luamqtt/mqtt/luasocket.lua",
  "module": "Default luamqtt network connector, based on luasocket. It manipulates a connection table 'conn' (host, port, sock, timeout) created by the MQTT client. Each function takes conn as its first argument; errors are returned as false, 'text'.",
  "notes": [
    "Uses require('socket') (the luasocket module by bare name)."
  ],
  "functions": {
    "connect": {
      "desc": "Opens a TCP connection to conn.host:conn.port via socket.connect and stores the socket in conn.sock.",
      "params": {
        "conn": {
          "type": "table",
          "desc": "Connection table (host, port)."
        }
      },
      "returns": [
        {
          "type": "boolean",
          "desc": "true if connected, false otherwise."
        },
        {
          "type": "string|nil",
          "desc": "Error message."
        }
      ]
    },
    "shutdown": {
      "desc": "Closes the connection with conn.sock:shutdown().",
      "params": {
        "conn": {
          "type": "table",
          "desc": "Connection."
        }
      }
    },
    "send": {
      "desc": "Sends data (conn.sock:send).",
      "params": {
        "conn": {
          "type": "table",
          "desc": "Connection."
        },
        "data": {
          "type": "string",
          "desc": "Data."
        },
        "i": {
          "type": "integer|nil",
          "desc": "Substring start."
        },
        "j": {
          "type": "integer|nil",
          "desc": "Substring end."
        }
      },
      "returns": [
        {
          "type": "integer|nil",
          "desc": "Index of the last byte sent."
        },
        {
          "type": "string|nil",
          "desc": "Error."
        }
      ]
    },
    "receive": {
      "desc": "Receives exactly size bytes (conn.sock:receive).",
      "params": {
        "conn": {
          "type": "table",
          "desc": "Connection."
        },
        "size": {
          "type": "integer",
          "desc": "Bytes to read."
        }
      },
      "returns": [
        {
          "type": "string|nil",
          "desc": "Data."
        },
        {
          "type": "string|nil",
          "desc": "Error, e.g. 'timeout' or 'closed'."
        }
      ]
    },
    "settimeout": {
      "desc": "Stores conn.timeout and sets the socket's total timeout (mode 't').",
      "params": {
        "conn": {
          "type": "table",
          "desc": "Connection."
        },
        "timeout": {
          "type": "number|nil",
          "desc": "Seconds."
        }
      }
    }
  }
}
