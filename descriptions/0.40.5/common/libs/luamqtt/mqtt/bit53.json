{
  "path": "lua/common/libs/luamqtt/mqtt/bit53.lua",
  "module": "Fallback implementation of a few BitOp functions (lshift, rshift, bor, band) with Lua 5.3's native operators (<<, >>, |, &). Loaded by bitwrap only if the interpreter is neither Lua 5.1/LuaJIT nor Lua 5.2. In BeamNG (LuaJIT) it is never loaded.",
  "notes": [
    "Do not load it under LuaJIT: the Lua 5.3 bitwise operator syntax is not valid there and would cause a compile error."
  ],
  "functions": {
    "lshift": {
      "desc": "Left shift.",
      "params": {
        "x": {
          "type": "integer",
          "desc": "Value."
        },
        "n": {
          "type": "integer",
          "desc": "Number of bits."
        }
      },
      "returns": [
        {
          "type": "integer",
          "desc": "x << n."
        }
      ]
    },
    "rshift": {
      "desc": "Right shift.",
      "params": {
        "x": {
          "type": "integer",
          "desc": "Value."
        },
        "n": {
          "type": "integer",
          "desc": "Number of bits."
        }
      },
      "returns": [
        {
          "type": "integer",
          "desc": "x >> n."
        }
      ]
    },
    "bor": {
      "desc": "Bitwise OR.",
      "params": {
        "x1": {
          "type": "integer",
          "desc": "Value."
        },
        "x2": {
          "type": "integer",
          "desc": "Value."
        }
      },
      "returns": [
        {
          "type": "integer",
          "desc": "x1 | x2."
        }
      ]
    },
    "band": {
      "desc": "Bitwise AND.",
      "params": {
        "x1": {
          "type": "integer",
          "desc": "Value."
        },
        "x2": {
          "type": "integer",
          "desc": "Value."
        }
      },
      "returns": [
        {
          "type": "integer",
          "desc": "x1 & x2."
        }
      ]
    }
  }
}
