{
  "path": "lua/common/libs/luamqtt/mqtt/ngxsocket.lua",
  "module": "luamqtt network connector for OpenResty/nginx (ngx.socket.tcp). Unusable in BeamNG: the file reads the global ngx at load time, which does not exist in the game. Same interface as the other connectors.",
  "notes": [
    "Loading the module raises an error outside OpenResty (ngx is nil: ngx.socket.tcp).",
    "settimeout converts seconds to milliseconds; without a timeout, it uses 0x7FFFFFFF."
  ],
  "functions": {
    "connect": {
      "desc": "Opens an ngx socket, connects to conn.host:conn.port (very long timeout), performs sslhandshake if conn.secure, stores it in conn.sock.",
      "params": {
        "conn": {
          "type": "table",
          "desc": "host, port, secure."
        }
      },
      "returns": [
        {
          "type": "boolean",
          "desc": "Success."
        },
        {
          "type": "string|nil",
          "desc": "Error."
        }
      ]
    },
    "shutdown": {
      "desc": "Closes the socket.",
      "params": {
        "conn": {
          "type": "table",
          "desc": "Connection."
        }
      }
    },
    "send": {
      "desc": "Sends the data (substring i..j if i is given).",
      "params": {
        "conn": {
          "type": "table",
          "desc": "Connection."
        },
        "data": {
          "type": "string",
          "desc": "Data."
        },
        "i": {
          "type": "integer|nil",
          "desc": "Start."
        },
        "j": {
          "type": "integer|nil",
          "desc": "End."
        }
      }
    },
    "receive": {
      "desc": "Receives size bytes.",
      "params": {
        "conn": {
          "type": "table",
          "desc": "Connection."
        },
        "size": {
          "type": "integer",
          "desc": "Bytes."
        }
      }
    },
    "settimeout": {
      "desc": "Sets the socket timeout.",
      "params": {
        "conn": {
          "type": "table",
          "desc": "Connection."
        },
        "timeout": {
          "type": "number|nil",
          "desc": "Seconds."
        }
      }
    }
  }
}
