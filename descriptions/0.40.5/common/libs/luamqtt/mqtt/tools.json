{
  "path": "lua/common/libs/luamqtt/mqtt/tools.lua",
  "module": "Two small luamqtt utilities: string-to-hexadecimal conversion and integer division. Used by protocol.lua and for debugging.",
  "functions": {
    "hex": {
      "desc": "Encodes each byte of the string as two uppercase hexadecimal digits.",
      "params": {
        "str": {
          "type": "string",
          "desc": "Source string."
        }
      },
      "returns": [
        {
          "type": "string",
          "desc": "Hexadecimal string."
        }
      ]
    },
    "div": {
      "desc": "Integer division: math.floor(x / y).",
      "params": {
        "x": {
          "type": "number",
          "desc": "Dividend."
        },
        "y": {
          "type": "number",
          "desc": "Divisor."
        }
      },
      "returns": [
        {
          "type": "integer",
          "desc": "Quotient rounded down."
        }
      ]
    }
  }
}
