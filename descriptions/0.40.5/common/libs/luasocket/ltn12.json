{
  "path": "lua/common/libs/luasocket/ltn12.lua",
  "module": "LTN12 1.0.3 (Diego Nehab, LuaSocket library): framework for processing data streams in chunks. Four concepts: sources (functions that return the next chunk), sinks (functions that receive chunks), filters (transform one chunk into another) and pumps (transfer from a source to a sink). Used by socket.http, socket.ftp and mime; a modder uses it to read/write HTTP responses as streams (table, file, string).",
  "usage": "local ltn12 = require('libs/luasocket/ltn12')\nlocal t = {}\nltn12.pump.all(ltn12.source.string('bonjour'), ltn12.sink.table(t))\nprint(table.concat(t))",
  "notes": [
    "Conventions: a source returns the next chunk, or nil (end) or nil, error. A sink receives (chunk, error) and returns 1 to continue, or nil, error; it receives nil as the chunk to signal the end. A filter receives a chunk (nil = end) and returns a chunk ('' = nothing for now, nil = done).",
    "If the global 'module' exists (Lua 5.1 with compat), the module is also published in _G.ltn12 via rawset.",
    "sink.chain calls unpack, which is not defined in this file: it works under LuaJIT (global unpack) but not under Lua 5.2+.",
    "The functions are fields of nested tables: ltn12.source.*, ltn12.sink.*, ltn12.filter.*, ltn12.pump.* (the auto page presents them as classes)."
  ],
  "fields": {
    "BLOCKSIZE": {
      "type": "integer",
      "desc": "Size of the chunks read by source.file and source.string: 2048 bytes."
    },
    "_VERSION": {
      "type": "string",
      "desc": "'LTN12 1.0.3'."
    },
    "filter": {
      "type": "table",
      "desc": "Filter functions: cycle, chain."
    },
    "source": {
      "type": "table",
      "desc": "Source factories: empty, error, file, simplify, string, rewind, chain, cat."
    },
    "sink": {
      "type": "table",
      "desc": "Sink factories: table, simplify, file, null, error, chain."
    },
    "pump": {
      "type": "table",
      "desc": "Data transfer: step, all."
    }
  },
  "classes": {
    "filter": {
      "desc": "ltn12.filter: filter construction.",
      "functions": {
        "cycle": {
          "desc": "Turns a low-level filter low(ctx, chunk, extra) -> (output, new ctx) into a high-level filter that keeps the context between calls.",
          "params": {
            "low": {
              "type": "function",
              "desc": "Low-level filter."
            },
            "ctx": {
              "type": "any",
              "desc": "Initial context."
            },
            "extra": {
              "type": "any",
              "desc": "Extra argument passed to low."
            }
          },
          "returns": [
            {
              "type": "function",
              "desc": "High-level filter."
            }
          ]
        },
        "chain": {
          "desc": "Chains several filters into one.",
          "params": {
            "...": {
              "type": "function",
              "desc": "Filters to chain, in order."
            }
          },
          "returns": [
            {
              "type": "function",
              "desc": "Composite filter."
            }
          ]
        }
      }
    },
    "source": {
      "desc": "ltn12.source: source factories.",
      "functions": {
        "empty": {
          "desc": "Empty source: always returns nil.",
          "returns": [
            {
              "type": "function",
              "desc": "Source."
            }
          ]
        },
        "error": {
          "desc": "Source that always returns nil, err.",
          "params": {
            "err": {
              "type": "string",
              "desc": "Error."
            }
          },
          "returns": [
            {
              "type": "function",
              "desc": "Source."
            }
          ]
        },
        "file": {
          "desc": "Source that reads a file in BLOCKSIZE blocks and closes it at the end. Without a handle, returns an error source.",
          "params": {
            "handle": {
              "type": "file*|nil",
              "desc": "Open file."
            },
            "io_err": {
              "type": "string|nil",
              "desc": "Error message if handle is nil (default 'unable to open file')."
            }
          },
          "returns": [
            {
              "type": "function",
              "desc": "Source."
            }
          ]
        },
        "simplify": {
          "desc": "Turns a 'sophisticated' source (which may return a new source) into a simple source.",
          "params": {
            "src": {
              "type": "function",
              "desc": "Source."
            }
          },
          "returns": [
            {
              "type": "function",
              "desc": "Simple source."
            }
          ]
        },
        "string": {
          "desc": "Source that splits a string into BLOCKSIZE chunks. Without a string, returns an empty source.",
          "params": {
            "s": {
              "type": "string|nil",
              "desc": "String."
            }
          },
          "returns": [
            {
              "type": "function",
              "desc": "Source."
            }
          ]
        },
        "rewind": {
          "desc": "'Rewindable' source: called with a chunk, it sets it aside; without an argument, it first returns the chunks set aside, then the original source.",
          "params": {
            "src": {
              "type": "function",
              "desc": "Source."
            }
          },
          "returns": [
            {
              "type": "function",
              "desc": "Rewindable source."
            }
          ]
        },
        "chain": {
          "desc": "Filtered source: applies one or more filters to a source.",
          "params": {
            "src": {
              "type": "function",
              "desc": "Source."
            },
            "f": {
              "type": "function",
              "desc": "Filter."
            },
            "...": {
              "type": "function",
              "desc": "Additional filters."
            }
          },
          "returns": [
            {
              "type": "function",
              "desc": "Source."
            }
          ]
        },
        "cat": {
          "desc": "Concatenates several sources one after another.",
          "params": {
            "...": {
              "type": "function",
              "desc": "Sources."
            }
          },
          "returns": [
            {
              "type": "function",
              "desc": "Source."
            }
          ]
        }
      }
    },
    "sink": {
      "desc": "ltn12.sink: sink factories.",
      "functions": {
        "table": {
          "desc": "Sink that stores each chunk in a table.",
          "params": {
            "t": {
              "type": "table|nil",
              "desc": "Destination table (created if absent)."
            }
          },
          "returns": [
            {
              "type": "function",
              "desc": "Sink."
            },
            {
              "type": "table",
              "desc": "Table used."
            }
          ]
        },
        "simplify": {
          "desc": "Turns a 'sophisticated' sink into a simple sink.",
          "params": {
            "snk": {
              "type": "function",
              "desc": "Sink."
            }
          },
          "returns": [
            {
              "type": "function",
              "desc": "Simple sink."
            }
          ]
        },
        "file": {
          "desc": "Sink that writes to a file and closes it at the end. Without a handle, returns an error sink.",
          "params": {
            "handle": {
              "type": "file*|nil",
              "desc": "Open file."
            },
            "io_err": {
              "type": "string|nil",
              "desc": "Error message (default 'unable to open file')."
            }
          },
          "returns": [
            {
              "type": "function",
              "desc": "Sink."
            }
          ]
        },
        "null": {
          "desc": "Sink that ignores the data.",
          "returns": [
            {
              "type": "function",
              "desc": "Sink."
            }
          ]
        },
        "error": {
          "desc": "Sink that always returns nil, err.",
          "params": {
            "err": {
              "type": "string",
              "desc": "Error."
            }
          },
          "returns": [
            {
              "type": "function",
              "desc": "Sink."
            }
          ]
        },
        "chain": {
          "desc": "Sink preceded by one or more filters.",
          "params": {
            "f": {
              "type": "function",
              "desc": "Filter."
            },
            "snk": {
              "type": "function",
              "desc": "Sink (or another filter followed by other arguments; the last argument is the sink)."
            },
            "...": {
              "type": "function",
              "desc": "Extra elements."
            }
          },
          "returns": [
            {
              "type": "function",
              "desc": "Sink."
            }
          ]
        }
      }
    },
    "pump": {
      "desc": "ltn12.pump: source-to-sink transfer.",
      "functions": {
        "step": {
          "desc": "Transfers one chunk from the source to the sink.",
          "params": {
            "src": {
              "type": "function",
              "desc": "Source."
            },
            "snk": {
              "type": "function",
              "desc": "Sink."
            }
          },
          "returns": [
            {
              "type": "integer|nil",
              "desc": "1 if a chunk was transferred; nil (and possibly the error) at the end or on error."
            }
          ]
        },
        "all": {
          "desc": "Transfers all the data from the source to the sink using the step function.",
          "params": {
            "src": {
              "type": "function",
              "desc": "Source."
            },
            "snk": {
              "type": "function",
              "desc": "Sink."
            },
            "step": {
              "type": "function|nil",
              "desc": "Step function (default pump.step)."
            }
          },
          "returns": [
            {
              "type": "integer|nil",
              "desc": "1 on success; nil and the error otherwise."
            }
          ]
        }
      }
    }
  }
}
