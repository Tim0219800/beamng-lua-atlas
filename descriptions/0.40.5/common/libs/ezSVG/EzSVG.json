        },
        "x2": {
          "type": "number",
          "desc": "End X"
        },
        "y2": {
          "type": "number",
          "desc": "End Y"
        },
        "userSpaceUnits": {
          "type": "boolean|nil",
          "desc": "Use user units (inferred from the name)"
        },
        "spread": {
          "type": "string|nil",
          "desc": "Spread method (spreadMethod)"
        },
        "style": {
          "type": "table|nil",
          "desc": "Style"
        }
      }
    },
    "RadialGradient": {
      "desc": "Creates a radial gradient.",
      "params": {
        "cx": {
          "type": "number",
          "desc": "Center X"
        },
        "cy": {
          "type": "number",
          "desc": "Center Y"
        },
        "r": {
          "type": "number",
          "desc": "Radius"
        },
        "fx": {
          "type": "number|nil",
          "desc": "Focus X"
        },
        "fy": {
          "type": "number|nil",
          "desc": "Focus Y"
        },
        "userSpaceUnits": {
          "type": "boolean|nil",
          "desc": "Use user units (inferred from the name)"
        },
        "spread": {
          "type": "string|nil",
          "desc": "Spread method"
        },
        "style": {
          "type": "table|nil",
          "desc": "Style"
        }
      }
    },
    "rgb": {
      "desc": "Formats an SVG color \"rgb(r, g, b)\" (values 0..255, rounded down to the integer).",
      "params": {
        "r": {
          "type": "number",
          "desc": "Red"
        },
        "g": {
          "type": "number",
          "desc": "Green"
        },
        "b": {
          "type": "number",
          "desc": "Blue"
        }
      },
      "returns": [
        {
          "type": "string",
          "desc": "Color"
        }
      ]
    },
    "gray": {
      "desc": "Gray: rgb(v, v, v).",
      "params": {
        "v": {
          "type": "number",
          "desc": "Level 0..255"
        }
      },
      "returns": [
        {
          "type": "string",
          "desc": "Color"
        }
      ]
    },
    "hsv": {
      "desc": "Converts a TSV color into an rgb() string. The three components are in 0..255 (divided by 255).",
      "params": {
        "h": {
          "type": "number",
          "desc": "Hue 0..255"
        },
        "s": {
          "type": "number",
          "desc": "Saturation 0..255"
        },
        "v": {
          "type": "number",
          "desc": "Value 0..255"
        }
      },
      "returns": [
        {
          "type": "string",
          "desc": "rgb(...) color"
        }
      ]
    }
  }
}
