{
  "path": "lua/common/libs/ezSVG/EzSVG.lua",
  "module": "EzSVG: third-party library (Patrick Borgeat, 2012, taken over by BeamNG) to generate SVG files from Lua. You create elements (Circle, Rect, Line, Path, Polyline, Text, Group, gradients...), add them to a group or a document (add) then write the file with Document:writeTo. A stack of default styles (setStyle, pushStyle, popStyle) applies to the elements created. Useful for exporting drawings (roads, graphs) from a script.",
  "usage": "local svg = require('libs/ezSVG/EzSVG')\nlocal doc = svg.Document(200, 200, svg.rgb(255,255,255))\ndoc:add(svg.Polyline({0, 0, 100, 100}, {fill = 'none', stroke = svg.rgb(255, 0, 0), stroke_width = 1}))\ndoc:writeTo('test.svg')",
  "notes": [
    "In style tables, keys with _ are converted to - (stroke_width becomes stroke-width).",
    "popStyle raises \"Style Stack Underflow!\" if the stack is empty.",
    "Document:writeTo performs a preliminary pass to place in <defs> the referenced objects that are not in the tree, then writes the file (io.open) without checking that the open succeeded.",
    "The last style argument of each constructor is optional."
  ],
  "fields": {
    "knownTags": {
      "type": "table<integer, string>",
      "desc": "List of known SVG tags (rect, circle, ellipse, line, polyline, polygon, path, text, tspan, textPath, image, svg, g, defs, tref, linearGradient, radialGradient, stop, use, symbol, pattern, mask) for which a default style exists."
    },
    "styleStack": {
      "type": "table",
      "desc": "Stack of style sets saved by pushStyle."
    }
  },
  "functions": {
    "clearStyle": {
      "desc": "Resets the default styles of all known tags (empty tables)."
    },
    "pushStyle": {
      "desc": "Saves a copy of the default styles on the stack."
    },
    "popStyle": {
      "desc": "Restores the saved default styles; error if the stack is empty."
    },
    "setStyle": {
      "desc": "Sets a default style, for one tag or for all. Accepts either (key, value, tag?), or (style table, tag?).",
      "params": {
        "key": {
          "type": "string|table",
          "desc": "Property name (stroke_width...) or table of properties"
        },
        "value": {
          "type": "any",
          "desc": "Value (or tag name if key is a table)"
        },
        "tag": {
          "type": "string|nil",
          "desc": "Targeted tag; all if nil"
        }
      }
    },
    "Document": {
      "desc": "Creates the root SVG document (svg group with xmlns, size and optional background). Has add and writeTo(filename).",
      "params": {
        "width": {
          "type": "number",
          "desc": "Width"
        },
        "height": {
          "type": "number",
          "desc": "Height"
        },
        "bgcolor": {
          "type": "string|nil",
          "desc": "Background color (adds a rectangle)"
        },
        "style": {
          "type": "table|nil",
          "desc": "Style"
        }
      },
      "returns": [
        {
          "type": "table",
          "desc": "Document"
        }
      ]
    },
    "SVG": {
      "desc": "Creates a nested <svg> element (positioned group).",
      "params": {
        "x": {
          "type": "number",
          "desc": "X"
        },
        "y": {
          "type": "number",
          "desc": "Y"
        },
        "width": {
          "type": "number",
          "desc": "Width"
        },
        "height": {
          "type": "number",
          "desc": "Height"
        },
        "style": {
          "type": "table|nil",
          "desc": "Style"
        }
      }
    },
    "Group": {
      "desc": "Creates a <g> group containing other elements (add method).",
      "params": {
        "style": {
          "type": "table|nil",
          "desc": "Style"
        }
      }
    },
    "Circle": {
      "desc": "Creates a circle.",
      "params": {
        "cx": {
          "type": "number",
          "desc": "Center X"
        },
        "cy": {
          "type": "number",
          "desc": "Center Y"
        },
        "r": {
          "type": "number",
          "desc": "Radius"
        },
        "style": {
          "type": "table|nil",
          "desc": "Style"
        }
      }
    },
    "Ellipse": {
      "desc": "Creates an ellipse.",
      "params": {
        "cx": {
          "type": "number",
          "desc": "Center X"
        },
        "cy": {
          "type": "number",
          "desc": "Center Y"
        },
        "rx": {
          "type": "number",
          "desc": "X radius"
        },
        "ry": {
          "type": "number",
          "desc": "Y radius"
        },
        "style": {
          "type": "table|nil",
          "desc": "Style"
        }
      }
    },
    "Line": {
      "desc": "Creates a line segment.",
      "params": {
        "x1": {
          "type": "number",
          "desc": "Start X"
        },
        "y1": {
          "type": "number",
          "desc": "Start Y"
        },
        "x2": {
          "type": "number",
          "desc": "End X"
        },
        "y2": {
          "type": "number",
          "desc": "End Y"
        },
        "style": {
          "type": "table|nil",
          "desc": "Style"
        }
      }
    },
    "Path": {
      "desc": "Creates a <path> whose d commands are built by methods on the object.",
      "params": {
        "style": {
          "type": "table|nil",
          "desc": "Style"
        }
      }
    },
    "Polyline": {
      "desc": "Creates an open polyline.",
      "params": {
        "points": {
          "type": "table<integer, number>",
          "desc": "Flat list of coordinates {x1, y1, x2, y2, ...}"
        },
        "style": {
          "type": "table|nil",
          "desc": "Style"
        }
      }
    },
    "Polygon": {
      "desc": "Creates a closed polygon.",
      "params": {
        "points": {
          "type": "table<integer, number>",
          "desc": "Flat list of coordinates {x1, y1, ...}"
        },
        "style": {
          "type": "table|nil",
          "desc": "Style"
        }
      }
    },
    "Rect": {
      "desc": "Creates a rectangle, optionally with rounded corners.",
      "params": {
        "x": {
          "type": "number",
          "desc": "X"
        },
        "y": {
          "type": "number",
          "desc": "Y"
        },
        "width": {
          "type": "number",
          "desc": "Width"
        },
        "height": {
          "type": "number",
          "desc": "Height"
        },
        "rx": {
          "type": "number|nil",
          "desc": "Corner radius in X"
        },
        "ry": {
          "type": "number|nil",
          "desc": "Corner radius in Y"
        },
        "style": {
          "type": "table|nil",
          "desc": "Style"
        }
      }
    },
    "Image": {
      "desc": "Creates a referenced image.",
      "params": {
        "href": {
          "type": "string",
          "desc": "Image URL or path"
        },
        "x": {
          "type": "number",
          "desc": "X"
        },
        "y": {
          "type": "number",
          "desc": "Y"
        },
        "width": {
          "type": "number",
          "desc": "Width"
        },
        "height": {
          "type": "number",
          "desc": "Height"
        },
        "style": {
          "type": "table|nil",
          "desc": "Style"
        }
      }
    },
    "Text": {
      "desc": "Creates a text element.",
      "params": {
        "text": {
          "type": "string",
          "desc": "Content"
        },
        "x": {
          "type": "number",
          "desc": "X"
        },
        "y": {
          "type": "number",
          "desc": "Y"
        },
        "style": {
          "type": "table|nil",
          "desc": "Style"
        }
      }
    },
    "TextRef": {
      "desc": "Creates a text reference (<tref>) to another element.",
      "params": {
        "href": {
          "type": "any",
          "desc": "Referenced element or identifier (inferred from code)"
        },
        "style": {
          "type": "table|nil",
          "desc": "Style"
        }
      }
    },
    "Use": {
      "desc": "Creates a <use> that reuses an element defined elsewhere.",
      "params": {
        "href": {
          "type": "any",
          "desc": "Element or identifier to reuse"
        },
        "x": {
          "type": "number|nil",
          "desc": "X"
        },
        "y": {
          "type": "number|nil",
          "desc": "Y"
        },
        "width": {
          "type": "number|nil",
          "desc": "Width"
        },
        "height": {
          "type": "number|nil",
          "desc": "Height"
        },
        "style": {
          "type": "table|nil",
          "desc": "Style"
        }
      }
    },
    "Symbol": {
      "desc": "Creates a <symbol> (reusable template via Use).",
      "params": {
        "preserveAspectRatio": {
          "type": "string|nil",
          "desc": "SVG attribute"
        },
        "viewBox": {
          "type": "string|nil",
          "desc": "SVG attribute"
        },
        "style": {
          "type": "table|nil",
          "desc": "Style"
        }
      }
    },
    "Pattern": {
      "desc": "Creates a <pattern> fill pattern.",
      "params": {
        "x": {
          "type": "number",
          "desc": "X"
        },
        "y": {
          "type": "number",
          "desc": "Y"
        },
        "width": {
          "type": "number",
          "desc": "Width"
        },
        "height": {
          "type": "number",
          "desc": "Height"
        },
        "preserveAspectRatio": {
          "type": "string|nil",
          "desc": "SVG attribute"
        },
        "patternUnits": {
          "type": "string|nil",
          "desc": "SVG attribute"
        },
        "patternContentUnits": {
          "type": "string|nil",
          "desc": "SVG attribute"
        },
        "viewbox": {
          "type": "string|nil",
          "desc": "SVG viewBox attribute"
        },
        "style": {
          "type": "table|nil",
          "desc": "Style"
        }
      }
    },
    "Mask": {
      "desc": "Creates a <mask> mask.",
      "params": {
        "x": {
          "type": "number",
          "desc": "X"
        },
        "y": {
          "type": "number",
          "desc": "Y"
        },
        "width": {
          "type": "number",
          "desc": "Width"
        },
        "height": {
          "type": "number",
          "desc": "Height"
        },
        "maskUnits": {
          "type": "string|nil",
          "desc": "SVG attribute"
        },
        "maskContentUnits": {
          "type": "string|nil",
          "desc": "SVG attribute"
        },
        "style": {
          "type": "table|nil",
          "desc": "Style"
        }
      }
    },
    "LinearGradient": {
      "desc": "Creates a linear gradient (stops added afterwards on the object).",
      "params": {
        "x1": {
          "type": "number",
          "desc": "Start X"
        },
        "y1": {
          "type": "number",
