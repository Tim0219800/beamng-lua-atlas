{
  "path": "lua/common/libs/lua-websockets/websocket/frame.lua",
  "module": "Encoding and decoding of WebSocket frames (RFC 6455) for lua-websockets: 7/16/64-bit length headers, client-side XOR masking, close frames (code + reason). Used by sync, ev_common and the client/server backends. Also exports the opcode constants.",
  "notes": [
    "Decoding a 64-bit length fails via assert if the length is less than 0xffff or greater than 2^53.",
    "xor_mask is marked 'TODO: improve performance' in the code: masking is done byte by byte in Lua."
  ],
  "fields": {
    "CONTINUATION": {
      "type": "integer",
      "desc": "0."
    },
    "TEXT": {
      "type": "integer",
      "desc": "1."
    },
    "BINARY": {
      "type": "integer",
      "desc": "2."
    },
    "CLOSE": {
      "type": "integer",
      "desc": "8."
    },
    "PING": {
      "type": "integer",
      "desc": "9."
    },
    "PONG": {
      "type": "integer",
      "desc": "10."
    }
  },
  "functions": {
    "encode": {
      "desc": "Builds a complete WebSocket frame: header, length, optional random mask (math.random) and masked data.",
      "params": {
        "data": {
          "type": "string",
          "desc": "Payload."
        },
        "opcode": {
          "type": "integer",
          "desc": "Opcode (1 = TEXT by default)."
        },
        "masked": {
          "type": "boolean",
          "desc": "true to mask (required on the client side)."
        },
        "fin": {
          "type": "boolean|nil",
          "desc": "FIN bit; nil or true = final frame."
        }
      },
      "returns": [
        {
          "type": "string",
          "desc": "Frame bytes."
        }
      ]
    },
    "decode": {
      "desc": "Decodes a frame from a buffer. If the data is incomplete, returns nil and the number of missing bytes.",
      "params": {
        "encoded": {
          "type": "string",
          "desc": "Bytes received (may contain several frames)."
        }
      },
      "returns": [
        {
          "type": "string|nil",
          "desc": "Unmasked payload, or nil if incomplete."
        },
        {
          "type": "boolean|integer",
          "desc": "fin (FIN bit), or missing bytes if incomplete."
        },
        {
          "type": "integer",
          "desc": "opcode."
        },
        {
          "type": "string",
          "desc": "Bytes remaining after the frame."
        },
        {
          "type": "boolean",
          "desc": "true if the frame was masked."
        }
      ]
    },
    "encode_close": {
      "desc": "Builds the payload of a CLOSE frame: 2-byte code followed by the reason. Returns an empty string if code is nil.",
      "params": {
        "code": {
          "type": "integer|nil",
          "desc": "Close code (e.g. 1000)."
        },
        "reason": {
          "type": "string|nil",
          "desc": "Reason."
        }
      },
      "returns": [
        {
          "type": "string",
          "desc": "Payload."
        }
      ]
    },
    "decode_close": {
      "desc": "Extracts code and reason from the payload of a CLOSE frame.",
      "params": {
        "data": {
          "type": "string|nil",
          "desc": "Payload."
        }
      },
      "returns": [
        {
          "type": "integer|nil",
          "desc": "Code."
        },
        {
          "type": "string|nil",
          "desc": "Reason."
        }
      ]
    },
    "encode_header_small": {
      "desc": "Two header bytes (length < 126).",
      "params": {
        "header": {
          "type": "integer",
          "desc": "First byte (FIN + opcode)."
        },
        "payload": {
          "type": "integer",
          "desc": "Second byte (mask bit + length)."
        }
      },
      "returns": [
        {
          "type": "string",
          "desc": "Header."
        }
      ]
    },
    "encode_header_medium": {
      "desc": "Header with a 16-bit length (126..65535).",
      "params": {
        "header": {
          "type": "integer",
          "desc": "First byte."
        },
        "payload": {
          "type": "integer",
          "desc": "Second byte."
        },
        "len": {
          "type": "integer",
          "desc": "Length."
        }
      },
      "returns": [
        {
          "type": "string",
          "desc": "Header."
        }
      ]
    },
    "encode_header_big": {
      "desc": "Header with a 64-bit length (two 32-bit integers).",
      "params": {
        "header": {
          "type": "integer",
          "desc": "First byte."
        },
        "payload": {
          "type": "integer",
          "desc": "Second byte."
        },
        "high": {
          "type": "integer",
          "desc": "High 32 bits."
        },
        "low": {
          "type": "integer",
          "desc": "Low 32 bits."
        }
      },
      "returns": [
        {
          "type": "string",
          "desc": "Header."
        }
      ]
    }
  }
}
