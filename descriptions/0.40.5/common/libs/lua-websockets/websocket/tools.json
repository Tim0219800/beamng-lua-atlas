{
  "path": "lua/common/libs/lua-websockets/websocket/tools.lua",
  "module": "Utilities of lua-websockets: reading/writing 8/16/32-bit big-endian integers, SHA-1 (via the 'crypto' library if present, otherwise a Lua implementation), base64 (via the luasocket 'mime' module), parsing ws:// URLs and generating the Sec-WebSocket-Key.",
  "notes": [
    "The module calls math.randomseed(os.time()) at load: this resets the global random seed (side effect on math.random for the rest of the VM).",
    "Uses require'mime' (bare name, not a libs/ path); this module must be findable."
  ],
  "fields": {
    "base64": {
      "type": "table",
      "desc": "Table with encode(data) -> base64 string (mime.b64)."
    },
    "sha1": {
      "type": "function",
      "desc": "SHA-1 function: crypto.digest if available, otherwise the in-house implementation; returns 20 raw bytes."
    },
    "write_int8": {
      "type": "function",
      "desc": "Alias of string.char: writes one or more bytes."
    }
  },
  "functions": {
    "read_int8": {
      "desc": "Reads a byte.",
      "params": {
        "str": {
          "type": "string",
          "desc": "Source."
        },
        "pos": {
          "type": "integer|nil",
          "desc": "Position (default 1)."
        }
      },
      "returns": [
        {
          "type": "integer",
          "desc": "New position."
        },
        {
          "type": "integer",
          "desc": "Value."
        }
      ]
    },
    "read_int16": {
      "desc": "Reads a big-endian 16-bit integer.",
      "params": {
        "str": {
          "type": "string",
          "desc": "Source."
        },
        "pos": {
          "type": "integer|nil",
          "desc": "Position."
        }
      },
      "returns": [
        {
          "type": "integer",
          "desc": "New position."
        },
        {
          "type": "integer",
          "desc": "Value."
        }
      ]
    },
    "read_int32": {
      "desc": "Reads a big-endian 32-bit integer.",
      "params": {
        "str": {
          "type": "string",
          "desc": "Source."
        },
        "pos": {
          "type": "integer|nil",
          "desc": "Position."
        }
      },
      "returns": [
        {
          "type": "integer",
          "desc": "New position."
        },
        {
          "type": "integer",
          "desc": "Value."
        }
      ]
    },
    "write_int16": {
      "desc": "Writes a big-endian 16-bit integer as 2 bytes.",
      "params": {
        "v": {
          "type": "integer",
          "desc": "Value."
        }
      },
      "returns": [
        {
          "type": "string",
          "desc": "2 bytes."
        }
      ]
    },
    "write_int32": {
      "desc": "Writes a big-endian 32-bit integer as 4 bytes.",
      "params": {
        "v": {
          "type": "integer",
          "desc": "Value."
        }
      },
      "returns": [
        {
          "type": "string",
          "desc": "4 bytes."
        }
      ]
    },
    "parse_url": {
      "desc": "Splits a ws:// or wss:// URL. Default port 80 (ws) or 443 (wss); uri defaults to '/'. Raises an error if the URL is invalid.",
      "params": {
        "url": {
          "type": "string",
          "desc": "URL."
        }
      },
      "returns": [
        {
          "type": "string",
          "desc": "Protocol in lowercase."
        },
        {
          "type": "string",
          "desc": "Host."
        },
        {
          "type": "integer",
          "desc": "Port."
        },
        {
          "type": "string",
          "desc": "URI."
        }
      ]
    },
    "generate_key": {
      "desc": "Generates a Sec-WebSocket-Key: 16 random bytes (math.random) in base64.",
      "returns": [
        {
          "type": "string",
          "desc": "Key."
        }
      ]
    }
  }
}
