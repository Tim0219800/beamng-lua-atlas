{
  "path": "lua/common/libs/copas/copas/semaphore.lua",
  "module": "Submodule of the third-party Copas library: counting semaphore for Copas coroutines. take requests resources (and waits if they are lacking), give returns them. The module returns the table semaphore.",
  "usage": "local sem = require(\"libs/copas/copas/semaphore\").new(3, 3, 5)\nsem:take()\n-- work limited to 3 coroutines in parallel\nsem:give()",
  "notes": [
    "new raises an error if max < 1 or if the timeout is negative; the default timeout is 10 s; start is 0 by default.",
    "give caps at max and returns the error \"too many\" on overflow."
  ],
  "fields": {
    "__index": {
      "type": "table",
      "desc": "Metatable of the semaphore objects."
    }
  },
  "functions": {
    "new": {
      "desc": "Creates a semaphore.",
      "params": {
        "max": {
          "type": "integer",
          "desc": "Maximum number of resources (must be greater than 0)"
        },
        "start": {
          "type": "integer|nil",
          "desc": "Resources available at the start (default 0)"
        },
        "seconds": {
          "type": "number|nil",
          "desc": "Default timeout in seconds (default 10)"
        }
      },
      "returns": [
        {
          "type": "table",
          "desc": "The semaphore"
        }
      ]
    },
    "give": {
      "desc": "Gives resources back to the semaphore (and wakes the waiting coroutines).",
      "params": {
        "self": {
          "type": "table",
          "desc": "The semaphore"
        },
        "given": {
          "type": "integer|nil",
          "desc": "Number of resources (default 1)"
        }
      },
      "returns": [
        {
          "type": "boolean|nil",
          "desc": "true on success"
        },
        {
          "type": "string|nil",
          "desc": "\"too many\" if the maximum is exceeded (the counter is capped)"
        }
      ]
    },
    "take": {
      "desc": "Requests resources; waits (yielding) as long as there are not enough. With timeout = 0, succeeds or fails immediately with \"timeout\".",
      "params": {
        "self": {
          "type": "table",
          "desc": "The semaphore"
        },
        "requested": {
          "type": "integer|nil",
          "desc": "Number requested (default 1)"
        },
        "timeout": {
          "type": "number|nil",
          "desc": "Timeout in seconds (default: the semaphore's)"
        }
      },
      "returns": [
        {
          "type": "boolean|nil",
          "desc": "true on success"
        },
        {
          "type": "string|nil",
          "desc": "Error, e.g. \"timeout\""
        }
      ]
    },
    "get_count": {
      "desc": "Number of resources currently available.",
      "params": {
        "self": {
          "type": "table",
          "desc": "The semaphore"
        }
      },
      "returns": [
        {
          "type": "integer",
          "desc": "Counter"
        }
      ]
    },
    "get_wait": {
      "desc": "Total shortfall of resources requested by the waiting coroutines.",
      "params": {
        "self": {
          "type": "table",
          "desc": "The semaphore"
        }
      },
      "returns": [
        {
          "type": "integer",
          "desc": "Total deficit"
        }
      ]
    }
  }
}
