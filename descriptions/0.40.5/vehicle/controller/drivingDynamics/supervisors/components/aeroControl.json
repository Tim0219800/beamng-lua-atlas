{
  "path": "lua/vehicle/controller/drivingDynamics/supervisors/components/aeroControl.lua",
  "module": "Yaw control component (type \"auxiliary\", defaultOrder 70) for active aerodynamics. It registers with the yawControl supervisor (order 30); when the vehicle oversteers (body slip angle of opposite sign to the yaw and above a threshold), it writes electrics.values.yawControlRequestReduceOversteer (1 or 0), which the vehicle's aero elements (wings, flaps) can read to reduce oversteer. Not used for traction control or ABS.",
  "notes": [
    "jbeam key: slipAngleThreshold (default 0.2 rad) = body slip threshold beyond which aero is requested.",
    "Modifiable parameters (setParameters): yawControl, yawControl.isEnabled, yawControl.slipAngleThreshold.",
    "The electrics.values.yawControlRequestReduceOversteer flag is smoothed (temporalSmoothing 1 / 1000, slow 1 s rise, almost immediate fall) then reduced to its sign (0 or 1): it stays at 1 during the smoother's rise even after the request ends.",
    "actAsTractionControl is replaced by nop at initSecondStage; actAsABSControl is nop. componentOrderTractionControl and componentOrderABSControl are 1000 (unused).",
    "The component only registers with yawControl if that supervisor exists (CMU.getSupervisor(\"yawControl\"))."
  ],
  "fields": {
    "type": {
      "type": "string",
      "desc": "\"auxiliary\"."
    },
    "defaultOrder": {
      "type": "number",
      "desc": "Default execution order (70)."
    },
    "componentOrderTractionControl": {
      "type": "number",
      "desc": "1000: never used as traction control."
    },
    "componentOrderYawControl": {
      "type": "number",
      "desc": "30: call order by yawControl."
    },
    "componentOrderABSControl": {
      "type": "number",
      "desc": "1000: never used as ABS."
    },
    "isActive": {
      "type": "boolean",
      "desc": "True after initSecondStage."
    },
    "isActingAsTC": {
      "type": "boolean",
      "desc": "Always false."
    },
    "isActingAsYC": {
      "type": "boolean",
      "desc": "True when oversteer reduction is requested."
    },
    "isActingAsABS": {
      "type": "boolean",
      "desc": "Always false."
    },
    "actAsABSControl": {
      "type": "function",
      "desc": "nop."
    }
  },
  "functions": {
    "init": {
      "desc": "Resets the action flags to false.",
      "params": {
        "jbeamData": {
          "type": "table",
          "desc": "Jbeam data."
        }
      },
      "returns": [],
      "internal": true
    },
    "initSecondStage": {
      "desc": "Registers with yawControl, reads slipAngleThreshold and sets isActive to true.",
      "params": {
        "jbeamData": {
          "type": "table",
          "desc": "Jbeam data."
        }
      },
      "returns": [],
      "internal": true
    },
    "initLastStage": {
      "desc": "Does nothing.",
      "params": {
        "jbeamData": {
          "type": "table",
          "desc": "Jbeam data."
        }
      },
      "returns": [],
      "internal": true
    },
    "reset": {
      "desc": "Resets the flags and the smoother.",
      "params": {},
      "returns": [],
      "internal": true
    },
    "updateGFX": {
      "desc": "Empty (debug version: sends a state packet to the CMU).",
      "params": {
        "dt": {
          "type": "number",
          "desc": "Graphics time step (s)."
        }
      },
      "returns": [],
      "internal": true
    },
    "actAsTractionControl": {
      "desc": "Called by tractionControl; does nothing (returns false, replaced by nop at init).",
      "params": {
        "wheelGroup": {
          "type": "table",
          "desc": "Wheel group."
        },
        "dt": {
          "type": "number",
          "desc": "Time step (s)."
        }
      },
      "returns": [
        {
          "type": "boolean",
          "desc": "false."
        }
      ],
      "internal": true
    },
    "actAsYawControl": {
      "desc": "Called by yawControl at every fixed step: detects oversteer via the body slip angle and updates electrics.values.yawControlRequestReduceOversteer.",
      "params": {
        "measuredYaw": {
          "type": "number",
          "desc": "Measured yaw (rad/s)."
        },
        "expectedYaw": {
          "type": "number",
          "desc": "Expected yaw (rad/s), unused."
        },
        "yawDifference": {
          "type": "number",
          "desc": "Yaw error, unused."
        },
        "bodySlipAngle": {
          "type": "number",
          "desc": "Adjusted body slip angle (rad)."
        },
        "frontSlipAngle": {
          "type": "number",
          "desc": "Front slip angle (rad), unused."
        },
        "rearSlipAngle": {
          "type": "number",
          "desc": "Rear slip angle (rad), unused."
        },
        "dt": {
          "type": "number",
          "desc": "Time step (s)."
        }
      },
      "returns": [
        {
          "type": "boolean",
          "desc": "True if oversteer reduction is requested."
        }
      ],
      "internal": true
    },
    "setDebugMode": {
      "desc": "Enables/disables debug packets.",
      "params": {
        "debugEnabled": {
          "type": "boolean",
          "desc": "True to enable."
        }
      },
      "returns": []
    },
    "registerCMU": {
      "desc": "Stores the reference to the CMU.",
      "params": {
        "cmu": {
          "type": "table",
          "desc": "CMU controller."
        }
      },
      "returns": [],
      "internal": true
    },
    "shutdown": {
      "desc": "Disables the component.",
      "params": {},
      "returns": []
    },
    "setParameters": {
      "desc": "Applies parameters (see notes) via CMU.applyParameter.",
      "params": {
        "parameters": {
          "type": "table<string, any>",
          "desc": "E.g. {[\"yawControl.slipAngleThreshold\"] = 0.3}."
        }
      },
      "returns": []
    },
    "setConfig": {
      "desc": "Replaces the entire configuration.",
      "params": {
        "configTable": {
          "type": "table",
          "desc": "Table {yawControl = {isEnabled, slipAngleThreshold}}."
        }
      },
      "returns": []
    },
    "getConfig": {
      "desc": "Returns a copy of the configuration.",
      "params": {},
      "returns": [
        {
          "type": "table",
          "desc": "Copy of the configuration."
        }
      ]
    },
    "sendConfigData": {
      "desc": "Sends the configuration to the CMU (debug packet).",
      "params": {},
      "returns": []
    }
  }
}
