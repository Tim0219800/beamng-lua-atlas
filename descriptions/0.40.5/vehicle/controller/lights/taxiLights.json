{
  "path": "lua/vehicle/controller/lights/taxiLights.lua",
  "module": "Auxiliary controller for the taxi sign (type \"auxiliary\"). It stores a state among available, occupied, reserved, offDuty (default), driverDistress and exposes each state as an electrics value named \"<controllerName>_<state>\" equal to 1 for the active state and 0 for the others.",
  "notes": [
    "No jbeam key is read. The electrics names depend on the controller name (M.name).",
    "setTaxiState does not validate the state passed: an unknown value turns off all outputs."
  ],
  "fields": {
    "type": {
      "type": "string",
      "desc": "\"auxiliary\"."
    }
  },
  "functions": {
    "init": {
      "desc": "Initializes the offDuty state and the electrics names.",
      "params": {
        "jbeamData": {
          "type": "table",
          "desc": "Controller jbeam data."
        }
      },
      "returns": [],
      "internal": true
    },
    "reset": {
      "desc": "Resets to the offDuty state.",
      "params": {
        "jbeamData": {
          "type": "table",
          "desc": "Controller jbeam data."
        }
      },
      "returns": [],
      "internal": true
    },
    "updateGFX": {
      "desc": "Writes the 0/1 electrics values of each state.",
      "params": {
        "dt": {
          "type": "number",
          "desc": "Time step (s)."
        }
      },
      "returns": [],
      "internal": true
    },
    "setTaxiState": {
      "desc": "Changes the sign's state.",
      "params": {
        "state": {
          "type": "string",
          "desc": "\"available\", \"occupied\", \"reserved\", \"offDuty\" or \"driverDistress\"."
        }
      },
      "returns": []
    },
    "getTaxiState": {
      "desc": "Returns the current state.",
      "params": {},
      "returns": [
        {
          "type": "string",
          "desc": "Sign state."
        }
      ]
    },
    "getState": {
      "desc": "Returns the state for saving.",
      "params": {},
      "returns": [
        {
          "type": "table",
          "desc": "State table (reused)."
        }
      ]
    },
    "setState": {
      "desc": "Restores the state returned by getState (if valid).",
      "params": {
        "data": {
          "type": "table|nil",
          "desc": "State table."
        }
      },
      "returns": []
    }
  }
}
